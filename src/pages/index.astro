---
import { getRelativeLocaleUrl } from "astro:i18n";
import HomePage from "../components/HomePage.tsx";
import Layout from "../layouts/Layout.astro";

const localeUrls = {
  es: getRelativeLocaleUrl("es", ""),
  en: getRelativeLocaleUrl("en", ""),
  gl: getRelativeLocaleUrl("gl", ""),
};
---

<Layout
  lang="es"
  title="HackUDC27 · Hackea el futuro desde Galicia"
  description="Únete a la quinta edición de HackUDC, una hackathon de 36 horas en A Coruña."
>
  <HomePage client:load locale="es" localeUrls={localeUrls} />
</Layout>
