---
import { getRelativeLocaleUrl } from "astro:i18n";
import HomePage from "../../components/HomePage.tsx";
import Layout from "../../layouts/Layout.astro";

const localeUrls = {
  es: getRelativeLocaleUrl("es", ""),
  en: getRelativeLocaleUrl("en", ""),
  gl: getRelativeLocaleUrl("gl", ""),
};
---

<Layout
  lang="en"
  title="HackUDC27 · Hack the future from Galicia"
  description="Join the fifth edition of HackUDC, a 36-hour hackathon in A Coruña."
>
  <HomePage client:load locale="en" localeUrls={localeUrls} />
</Layout>
