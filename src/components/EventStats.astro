---
import { Image } from "astro:assets";
import assetEmiliaSimpatica from "@/assets/scene/emilia-simpatica.webp";
import assetStatsScene from "@/assets/scene/stats-scene.webp";
import assetStatsSea from "@/assets/scene/stats-sea.webp";
import Clock from "@lucide/astro/icons/clock";
import CodeXml from "@lucide/astro/icons/code-xml";
import Users from "@lucide/astro/icons/users";
import { copy, type Locale } from "@/i18n/copy";

interface Props {
  locale: Locale;
}

const t = copy[Astro.props.locale];
// Match the scene width to the section's --faro clamps, including the sea.
const sceneWidths = [400, 480, 700, 800, 900, 1000, 1200, 1400];
const sceneSizes =
  "(min-width: 1024px) clamp(43.2rem, 60.48vw, 56.16rem), clamp(23.76rem, 95.04vw, 30.24rem)";

// One icon per stat, in the same order as `t.stats`.
const icons = [Users, Clock, CodeXml];
const reel = Array.from({ length: 30 }, (_, index) => index % 10);
const stats = t.stats.map(([value, label], index) => {
  return {
    value,
    label,
    Icon: icons[index] ?? Users,
    characters: [...value].map((character) => ({
      character,
      digit: /^\d$/.test(character) ? Number(character) : undefined,
    })),
  };
});
---

<!-- The scene (lighthouse, beam and sea in one image, as drawn) stands on the
     section's floor from the left edge, outside the page width; its sea and
     beam fade out to the right into the background. Below desktop it follows
     the cards; on desktop the cards keep to the page width, pushed right just
     enough to clear the tower. `--faro` is the tower's width: the image is
     4.32 times wider and 0.485 times as tall as it is wide. -->
<section
  id="stats"
  class="relative z-1 overflow-x-clip bg-blue/30 pt-10 [--faro:clamp(5.5rem,22vw,7rem)] lg:flex lg:min-h-[calc(var(--faro)*4.32*0.485)] lg:items-center lg:py-16 lg:[--faro:clamp(10rem,14vw,13rem)]"
  aria-labelledby="stats-title"
  data-stats
>
  <div class="page-wrap z-1">
    <div class="stats-content">
      <h2
        class="display-heading motion-reduce:animate-none"
        data-stats-heading
        id="stats-title"
      >
        {t.statsTitle}
      </h2>

      <dl
        class="mt-6 grid gap-2 sm:grid-cols-(--stats-cols) sm:gap-4 lg:mt-10 lg:gap-6"
        style={`--stats-cols: repeat(${stats.length}, minmax(0, 1fr))`}
        data-stats-trigger
      >
        {stats.map(({ value, label, Icon, characters }) => (
          <div
            class="flex items-center gap-3 rounded-2xl border border-cream bg-cream/90 px-4 py-2.5 motion-reduce:animate-none sm:flex-col sm:gap-2 sm:px-4 sm:py-5"
            data-stat-card
          >
            <dt class="order-last ml-auto eyebrow text-ink/60 sm:ml-0">
              {label}
            </dt>
            <dd class="flex items-center gap-3 sm:flex-col">
              <span
                class="grid size-9 shrink-0 place-items-center rounded-full bg-blue/50"
                aria-hidden="true"
              >
                <Icon class="size-4.5" />
              </span>
              <span class="sr-only">{value}</span>
              <span
                class="font-sans text-[2rem] leading-[1.1] font-bold tracking-[-0.03em] tabular-nums lg:text-[clamp(2.25rem,2.8vw,2.75rem)]"
                aria-hidden="true"
                data-stat-value
              >
                {characters.map(({ character, digit }) =>
                  digit === undefined ? (
                    character
                  ) : (
                    <span class="stat-digit">
                      <span class="stat-digit-static" data-stat-static>
                        {character}
                      </span>
                      <span
                        class="stat-reel-window"
                        aria-hidden="true"
                        data-stat-window
                      >
                        <span
                          class="stat-reel"
                          data-stat-reel
                          data-stat-digit={digit}
                        >
                          {reel.map((reelDigit) => (
                            <span class="stat-reel-row">{reelDigit}</span>
                          ))}
                        </span>
                      </span>
                    </span>
                  ),
                )}
              </span>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </div>

  <Image
    class="pointer-events-none mt-4 block w-[calc(var(--faro)*4.32)] max-w-none select-none lg:absolute lg:bottom-0 lg:left-0 lg:mt-0"
    src={assetStatsScene}
    format="avif"
    quality={60}
    widths={sceneWidths}
    sizes={sceneSizes}
    alt=""
    width="1400"
    height="679"
    loading="lazy"
    decoding="async"
  />
  <!-- The same sea, mirrored, rises from the right edge so the waves meet
       mid-section instead of the right side ending empty. -->
  <Image
    class="pointer-events-none absolute right-0 bottom-0 hidden w-[calc(var(--faro)*4.32)] max-w-none select-none lg:block"
    src={assetStatsSea}
    widths={sceneWidths}
    sizes={sceneSizes}
    alt=""
    width="1400"
    height="307"
    loading="lazy"
    decoding="async"
  />
  <!-- Mirrored so it kicks outwards. A quarter of it runs off the right edge
       and its foot 2px past the floor: the section only clips horizontally
       and sits above the next one. -->
  <Image
    class="pointer-events-none absolute right-0 -bottom-[2px] z-2 w-[clamp(4.5rem,10vw,10rem)] max-w-none translate-x-[25%] select-none"
    src={assetEmiliaSimpatica}
    widths={[160, 320]}
    sizes="(min-width: 1600px) 160px, (min-width: 720px) 10vw, 72px"
    alt=""
    width="700"
    height="821"
    loading="lazy"
    decoding="async"
  />
</section>

<style>
  /* Give Safari an explicit, isolated clipping box around every rolling digit. */
  .stat-digit {
    position: relative;
    display: inline-block;
    height: 1.1em;
    line-height: 1.1em;
    vertical-align: baseline;
  }

  .stat-digit-static {
    display: block;
    height: 1.1em;
    line-height: 1.1em;
  }

  .stat-reel-window {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
    clip-path: inset(0);
    visibility: hidden;
  }

  .stat-reel {
    display: flex;
    flex-direction: column;
  }

  .stat-reel-row {
    display: block;
    height: 1.1em;
    flex: none;
    line-height: 1.1em;
    white-space: nowrap;
  }

  /* On desktop the copy starts clear of the tower, measured from page-wrap's */
  /* content edge (80rem max width, clamp(1.25rem, 6vw, 7rem) padding). */
  @media (min-width: 64rem) {
    .stats-content {
      margin-left: max(
        0px,
        calc(
          var(--faro) + 2rem - max(0px, (100vw - 80rem) / 2) -
            clamp(1.25rem, 6vw, 7rem)
        )
      );
    }
  }
</style>

<script>
  import { gsap } from "gsap";

  let observer: IntersectionObserver | undefined;
  let controller: AbortController | undefined;
  let timeline: gsap.core.Timeline | undefined;

  document.addEventListener("astro:page-load", () => {
    observer?.disconnect();
    timeline?.kill();
    controller?.abort();
    controller = new AbortController();

    const section = document.querySelector<HTMLElement>("[data-stats]");
    const heading = section?.querySelector<HTMLElement>("[data-stats-heading]");
    const trigger = section?.querySelector<HTMLElement>("[data-stats-trigger]");
    const cards = Array.from(
      section?.querySelectorAll<HTMLElement>("[data-stat-card]") ?? [],
    );
    const values = Array.from(
      section?.querySelectorAll<HTMLElement>("[data-stat-value]") ?? [],
    );
    const reels = Array.from(
      section?.querySelectorAll<HTMLElement>("[data-stat-reel]") ?? [],
    );
    const windows = Array.from(
      section?.querySelectorAll<HTMLElement>("[data-stat-window]") ?? [],
    );
    const staticDigits = Array.from(
      section?.querySelectorAll<HTMLElement>("[data-stat-static]") ?? [],
    );

    if (!section || !heading || !trigger || !cards.length) return;

    const animatedElements = [heading, ...cards];
    const showStaticValues = () => {
      values.forEach((value) => {
        value.removeAttribute("data-rolling");
      });
      gsap.set([...animatedElements, ...reels, ...windows, ...staticDigits], {
        clearProps: "opacity,transform,visibility",
      });
    };
    const clearAnimation = () => {
      observer?.disconnect();
      observer = undefined;
      timeline?.kill();
      timeline = undefined;
      showStaticValues();
    };
    const finishAnimation = () => {
      showStaticValues();
      timeline = undefined;
    };
    const motionPreference = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    );

    document.addEventListener("astro:before-swap", clearAnimation, {
      signal: controller.signal,
    });
    motionPreference.addEventListener(
      "change",
      () => {
        if (motionPreference.matches) clearAnimation();
      },
      { signal: controller.signal },
    );
    document.addEventListener(
      "visibilitychange",
      () => {
        if (!document.hidden) timeline?.progress(1);
      },
      { signal: controller.signal },
    );

    if (motionPreference.matches || !("IntersectionObserver" in window)) return;

    observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry?.isIntersecting) return;
        observer?.disconnect();
        observer = undefined;

        timeline = gsap.timeline({ onComplete: finishAnimation });
        timeline
          .fromTo(
            heading,
            { opacity: 0, y: 18 },
            { opacity: 1, y: 0, duration: 0.55, ease: "power2.out" },
          )
          .fromTo(
            cards,
            { opacity: 0, y: 18 },
            {
              opacity: 1,
              y: 0,
              duration: 0.55,
              stagger: 0.1,
              ease: "power2.out",
            },
            "-=0.3",
          );

        values.forEach((value, index) => {
          const valueReels = Array.from(
            value.querySelectorAll<HTMLElement>("[data-stat-reel]"),
          );
          const valueWindows = Array.from(
            value.querySelectorAll<HTMLElement>("[data-stat-window]"),
          );
          const valueStaticDigits = Array.from(
            value.querySelectorAll<HTMLElement>("[data-stat-static]"),
          );

          gsap.set(valueReels, { y: 0 });
          gsap.set(valueWindows, { visibility: "visible" });
          gsap.set(valueStaticDigits, { visibility: "hidden" });
          value.toggleAttribute("data-rolling", true);

          valueReels.forEach((reel, digitIndex) => {
            const digit = Number(reel.dataset.statDigit);
            const rowHeight =
              reel.firstElementChild?.getBoundingClientRect().height ?? 0;

            if (
              !Number.isInteger(digit) ||
              digit < 0 ||
              digit > 9 ||
              !rowHeight
            )
              return;

            timeline?.to(
              reel,
              {
                y: -(20 + digit) * rowHeight,
                duration: 1.35,
                ease: "power3.out",
                force3D: false,
              },
              0.42 + index * 0.1 + digitIndex * 0.045,
            );
          });
        });
      },
      { threshold: 0.15, rootMargin: "0px 0px -8% 0px" },
    );
    observer.observe(trigger);
  });
</script>
