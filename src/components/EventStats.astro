---
import Clock from "@lucide/astro/icons/clock";
import CodeXml from "@lucide/astro/icons/code-xml";
import Users from "@lucide/astro/icons/users";
import { copy, type Locale } from "@/i18n/copy";

interface Props {
  locale: Locale;
}

const t = copy[Astro.props.locale];

// One icon per stat, in the same order as `t.stats`.
const icons = [Users, Clock, CodeXml];
// Three rounds of 0–9, so every digit rolls through at least two full turns
// before landing on its value in the last round.
const reel = Array.from({ length: 30 }, (_, index) => index % 10);
const stats = t.stats.map(([value, label], index) => ({
  value,
  label,
  Icon: icons[index] ?? Users,
  characters: [...value].map((character) => ({
    character,
    end: /\d/.test(character) ? 20 + Number(character) : undefined,
  })),
}));
---

<!-- The scene (lighthouse, beam and sea in one image, as drawn) stands on the
     section's floor from the left edge, outside the page width; its sea and
     beam fade out to the right into the background. Below desktop it follows
     the cards; on desktop the cards keep to the page width, pushed right just
     enough to clear the tower. `--faro` is the tower's width: the image is
     4.32 times wider and 0.485 times as tall as it is wide. -->
<section
  id="stats"
  class="relative z-1 overflow-x-clip bg-blue/30 pt-10 [--faro:clamp(5.5rem,22vw,7rem)] lg:flex lg:min-h-[calc(var(--faro)*4.32*0.485)] lg:items-center lg:py-16 lg:[--faro:clamp(10rem,14vw,13rem)]"
  aria-labelledby="stats-title"
  data-stats
>
  <div class="page-wrap z-1">
    <div class="stats-content">
      <h2 class="display-heading reveal" data-reveal id="stats-title">
        {t.statsTitle}
      </h2>

      <dl
        class="mt-6 grid gap-2 sm:grid-cols-(--stats-cols) sm:gap-4 lg:mt-10 lg:gap-6"
        style={`--stats-cols: repeat(${stats.length}, minmax(0, 1fr))`}
      >
        {stats.map(({ value, label, Icon, characters }, index) => (
          <div
            class="reveal flex items-center gap-3 rounded-2xl border border-cream bg-cream/90 px-4 py-2.5 sm:flex-col sm:gap-2 sm:px-4 sm:py-5"
            style={`transition-delay: ${index * 80}ms`}
            data-reveal
          >
            <dt class="order-last ml-auto eyebrow text-ink/60 sm:ml-0">
              {label}
            </dt>
            <dd class="flex items-center gap-3 sm:flex-col">
              <span
                class="grid size-9 shrink-0 place-items-center rounded-full bg-blue/50"
                aria-hidden="true"
              >
                <Icon class="size-4.5" />
              </span>
              <span class="sr-only">{value}</span>
              <span
                class="flex font-sans text-[2rem] leading-none font-bold tracking-[-0.03em] tabular-nums lg:text-[clamp(2.25rem,2.8vw,2.75rem)]"
                aria-hidden="true"
              >
                {characters.map(({ character, end }) =>
                  end === undefined ? (
                    <span class="stat-window">{character}</span>
                  ) : (
                    <span class="stat-window" style={`--end: ${end}`}>
                      <span class="stat-reel">
                        {reel.map((digit) => (
                          <span>{digit}</span>
                        ))}
                      </span>
                    </span>
                  ),
                )}
              </span>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </div>

  <img
    class="pointer-events-none mt-4 block w-[calc(var(--faro)*4.32)] max-w-none select-none lg:absolute lg:bottom-0 lg:left-0 lg:mt-0"
    src="/assets/scene/stats-scene.webp"
    alt=""
    width="1400"
    height="679"
    loading="lazy"
    decoding="async"
  />
  <!-- The same sea, mirrored, rises from the right edge so the waves meet
       mid-section instead of the right side ending empty. -->
  <img
    class="pointer-events-none absolute right-0 bottom-0 hidden w-[calc(var(--faro)*4.32)] max-w-none select-none lg:block"
    src="/assets/scene/stats-sea.webp"
    alt=""
    width="1400"
    height="307"
    loading="lazy"
    decoding="async"
  />
  <!-- Mirrored so it kicks outwards. A quarter of it runs off the right edge
       and its foot 2px past the floor: the section only clips horizontally
       and sits above the next one. -->
  <img
    class="pointer-events-none absolute right-0 -bottom-[2px] w-[clamp(4.5rem,10vw,10rem)] max-w-none translate-x-[25%] select-none"
    src="/assets/scene/stats-seagull.webp"
    alt=""
    width="700"
    height="821"
    loading="lazy"
    decoding="async"
  />
</section>

<style>
  /* On desktop the copy starts clear of the tower, measured from page-wrap's */
  /* content edge (80rem max width, clamp(1.25rem, 6vw, 7rem) padding). */
  @media (min-width: 64rem) {
    .stats-content {
      margin-left: max(
        0px,
        calc(
          var(--faro) + 2rem - max(0px, (100vw - 80rem) / 2) -
            clamp(1.25rem, 6vw, 7rem)
        )
      );
    }
  }

  /* Every character sits in a one-line window, so all share a baseline. */
  /* Digits hold a reel that shows its last round by default. */
  .stat-window {
    display: block;
    height: 1.1em;
    line-height: 1.1em;
    /* Clips vertically only: `overflow: hidden` would shave the "%" glyph. */
    clip-path: inset(0 -0.25em);
  }

  .stat-reel {
    display: flex;
    flex-direction: column;
    transform: translateY(calc(var(--end) * -1.1em));
  }

  /* The script parks the reels at 0 and rolls them in view. */
  [data-stats][data-ready] .stat-reel {
    transform: translateY(0);
  }

  [data-stats][data-rolled] .stat-reel {
    transform: translateY(calc(var(--end) * -1.1em));
    transition: transform 1400ms var(--ease-out);
  }
</style>

<script>
  let observer: IntersectionObserver | undefined;
  let controller: AbortController | undefined;

  document.addEventListener("astro:page-load", () => {
    observer?.disconnect();
    controller?.abort();
    controller = new AbortController();
    document.addEventListener(
      "astro:before-swap",
      () => observer?.disconnect(),
      {
        signal: controller.signal,
      },
    );

    const section = document.querySelector<HTMLElement>("[data-stats]");
    if (!section || matchMedia("(prefers-reduced-motion: reduce)").matches) {
      return;
    }

    section.toggleAttribute("data-ready", true);
    observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry?.isIntersecting) return;
        section.toggleAttribute("data-rolled", true);
        observer?.disconnect();
      },
      { threshold: 0.4 },
    );
    observer.observe(section);
  });
</script>
