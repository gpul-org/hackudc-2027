---
import Linkedin from "@/assets/icons/linkedin.svg";
import Telegram from "@/assets/icons/telegram.svg";
import X from "@/assets/icons/x.svg";
import { copy, type Locale } from "@/i18n/copy";

interface Props {
  locale: Locale;
}

const t = copy[Astro.props.locale];
const sponsorPageUrl =
  Astro.props.locale === "es"
    ? "/sponsors/"
    : `/${Astro.props.locale}/sponsors/`;
// The footer lists every network; the floating bar keeps only the main ones.
const socials = [
  { label: "X", href: "https://x.com/gpul_", icon: X },
  { label: "Telegram", href: "https://t.me/+PrK44xhqJ9eP9ZUf", icon: Telegram },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/company/gpul/",
    icon: Linkedin,
  },
];
const pill =
  "rounded-full px-4 py-3 text-xs font-extrabold tracking-wide shadow-sm transition duration-200 ease-out hover:-translate-y-0.5";
---

<!-- Shown while neither the site header nor the footer is in view. -->
<div
  class="invisible fixed inset-x-0 bottom-0 z-20 flex translate-y-4 items-end justify-between gap-3 p-4 opacity-0 transition-[opacity,translate,visibility] duration-300 ease-out data-visible:visible data-visible:translate-y-0 data-visible:opacity-100 sm:p-6"
  data-fixed-ui
>
  <nav
    class="hidden rounded-full bg-cream/90 p-1.5 shadow-sm backdrop-blur sm:block"
    aria-label="Social media"
  >
    <ul class="flex items-end gap-1.5">
      {socials.map(({ label, href, icon: Icon }) => (
        <li class="group relative">
          <span
            class="pointer-events-none absolute bottom-full left-1/2 mb-5 -translate-x-1/2 translate-y-1 rounded-full bg-ink px-2.5 py-1 text-[0.65rem] font-extrabold tracking-wide whitespace-nowrap text-cream opacity-0 transition duration-200 ease-out group-focus-within:translate-y-0 group-focus-within:opacity-100 group-hover:translate-y-0 group-hover:opacity-100 motion-reduce:transition-none"
            aria-hidden="true"
          >
            {label}
          </span>
          <a
            class="grid size-10 origin-bottom place-items-center rounded-full bg-ink/5 text-ink transition duration-200 ease-out group-hover:scale-125 group-hover:bg-ink group-hover:text-cream focus-visible:scale-125 motion-reduce:transition-none"
            href={href}
            aria-label={label}
          >
            <Icon class="size-4.5" aria-hidden="true" />
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <div class="ml-auto flex gap-2">
    <a
      class={`${pill} bg-ink text-cream hover:bg-red`}
      href="https://nocodb.gpul.org/dashboard/#/nc/form/f1137831-84ad-4682-93de-a416cc592ff1"
      target="_blank"
      rel="noopener noreferrer"
    >
      {t.waitlistShort}
    </a>
    <a
      class={`${pill} bg-cream text-ink hover:bg-yellow`}
      href={sponsorPageUrl}
    >
      {t.sponsor}
    </a>
  </div>
</div>

<script>
  let observer: IntersectionObserver | undefined;

  document.addEventListener("astro:page-load", () => {
    observer?.disconnect();
    const ui = document.querySelector("[data-fixed-ui]");
    const header = document.querySelector("[data-site-header]");
    const footer = document.querySelector("[data-site-footer]");
    if (!ui || !header || !footer) return;

    const inView = new Map<Element, boolean>();
    observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) =>
        inView.set(entry.target, entry.isIntersecting),
      );
      ui.toggleAttribute(
        "data-visible",
        !inView.get(header) && !inView.get(footer),
      );
    });
    observer.observe(header);
    observer.observe(footer);
  });
</script>
