---
import { copy, type Locale } from "@/i18n/copy";

interface Props {
  locale: Locale;
}

const t = copy[Astro.props.locale];

// CTAs drawn as ornamented plaques; the artwork is the background.
const plaque =
  "grid aspect-[334/78] w-64 place-items-center bg-contain bg-center bg-no-repeat text-lg font-black tracking-wide uppercase transition duration-200 ease-out hover:-translate-y-0.5 lg:w-72 lg:text-xl";
---

<section
  class="relative isolate flex min-h-svh flex-col items-center overflow-hidden bg-linear-to-b from-[#5ba3e0] to-[#95d0f1] px-5 pt-[clamp(6rem,16svh,10rem)] text-center [--building:118vw] sm:[--building:72vw] lg:[--building:min(62vw,62rem)]"
  id="top"
  aria-labelledby="hero-title"
>
  <div class="relative z-2 flex flex-col items-center">
    <div class="relative flex flex-col items-center">
      <span class="mb-3 bg-red py-1.5 pr-5 pl-6 text-sm font-black tracking-wide text-cream [clip-path:polygon(0_0,calc(100%-0.75rem)_0,100%_50%,calc(100%-0.75rem)_100%,0_100%,0.75rem_50%)] sm:absolute sm:right-0 sm:bottom-full sm:mb-3 sm:text-base lg:text-xl">
        {t.edition}
      </span>
      <h1 id="hero-title">
        <picture class="block w-[min(55vw,14rem)] sm:w-[min(60vw,56rem,80svh)]">
          <source
            media="(width < 40rem)"
            srcset="/assets/brand/logo-vertical-navy.svg"
          />
          <img
            class="w-full animate-hero-logo motion-reduce:animate-none"
            src="/assets/brand/logo-navy.svg"
            alt="HackUDC27"
            width="1003"
            height="153"
          />
        </picture>
        <span class="sr-only">{t.title}</span>
      </h1>
    </div>

    <div
      class="mt-10 flex flex-col items-center gap-4 sm:mt-14 sm:flex-row sm:gap-10"
      id="waitlist"
    >
      <a
        class={`${plaque} bg-[url(/assets/scene/button-primary.svg)] text-cream`}
        href="mailto:hello@hackudc.gpul.org?subject=HackUDC27%20waitlist"
      >
        {t.waitlistShort}
      </a>
      <a
        class={`${plaque} bg-[url(/assets/scene/button-secondary.svg)] text-[#63bdee]`}
        href="mailto:sponsors@hackudc.gpul.org?subject=HackUDC27%20sponsorship"
      >
        {t.sponsor}
      </a>
    </div>
  </div>

  {/* Fills the height left below the CTAs so the hero is always one viewport tall. */}
  <div
    class="relative z-1 -mx-5 mt-10 min-h-40 flex-1 self-stretch"
    aria-hidden="true"
  >
    <div class="absolute top-[26%] left-[-4%] z-4 w-[108%] -rotate-5 overflow-hidden bg-cream py-3 text-sm font-black whitespace-nowrap text-neutral-950 sm:top-[38%] lg:text-lg">
      <div class="flex w-max animate-ticker motion-reduce:animate-none">
        <span class="shrink-0 whitespace-nowrap">{t.marquee.repeat(12)}</span>
        <span class="shrink-0 whitespace-nowrap" aria-hidden="true">
          {t.marquee.repeat(12)}
        </span>
      </div>
    </div>
    <img
      class="absolute bottom-0 left-1/2 z-2 aspect-1123/501 h-full max-h-(--building) w-auto max-w-(--building) -translate-x-1/2 object-cover object-top"
      src="/assets/scene/compass_bg.svg"
      alt=""
      width="1123"
      height="1121"
    />
    <div class="absolute inset-x-0 bottom-0 z-3 h-16 bg-linear-to-b from-transparent to-cream"></div>
  </div>
</section>
