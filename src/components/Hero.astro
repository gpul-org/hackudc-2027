---
import { copy, type Locale } from "@/i18n/copy";

interface Props {
  locale: Locale;
}

const t = copy[Astro.props.locale];
const sponsorPageUrl =
  Astro.props.locale === "es"
    ? "/sponsors/"
    : `/${Astro.props.locale}/sponsors/`;
---

<section
  class="relative isolate flex min-h-svh flex-col items-center overflow-hidden bg-linear-to-b from-blue via-blue to-cream px-5 pt-[clamp(6rem,16svh,10rem)] text-center max-lg:pt-[clamp(7.5rem,16svh,10rem)] [--building:90vw] [--mobile-logo-width:min(78vw,24rem)] sm:[--building:72vw] lg:[--building:min(62vw,62rem)]"
  id="top"
  aria-labelledby="hero-title"
>
  <div class="relative z-2 flex flex-col items-center">
    <div class="relative flex flex-col items-center">
      <span class="absolute right-0 bottom-full mb-3 animate-hero-enter bg-red py-1.5 pr-5 pl-6 text-sm font-black tracking-wide text-cream [animation-delay:140ms] [clip-path:polygon(0_0,calc(100%-0.75rem)_0,100%_50%,calc(100%-0.75rem)_100%,0_100%,0.75rem_50%)] motion-reduce:animate-none sm:text-base lg:text-xl">
        {t.edition}
      </span>
      <h1 id="hero-title">
        <picture class="block w-(--mobile-logo-width) sm:w-[min(60vw,56rem,80svh)]">
          <source
            media="(width < 40rem)"
            srcset="/assets/brand/logo-mobile-navy.svg"
          />
          <img
            class="w-full animate-hero-logo motion-reduce:animate-none"
            src="/assets/brand/logo-navy.svg"
            alt="HackUDC27"
            width="1003"
            height="153"
            fetchpriority="high"
          />
        </picture>
        <span class="sr-only">{t.title}</span>
      </h1>

      <div class="group mt-5 inline-grid -rotate-1 animate-hero-enter place-items-center border-2 border-ink bg-cream text-xs font-black tracking-[0.14em] whitespace-nowrap uppercase [animation-delay:260ms] motion-reduce:animate-none sm:mt-7 sm:text-sm">
        <span
          class="col-start-1 row-start-1 select-none px-5 py-2 text-ink blur-[6px]"
          aria-hidden="true"
        >
          {t.datePlaceholder}
        </span>
        <span class="z-1 col-start-1 row-start-1 -m-0.5 grid min-h-11 place-items-center self-stretch border-2 border-ink bg-blue px-5 py-2 text-ink shadow-[0_3px_0_var(--color-ink)] transition-transform duration-200 ease-out group-hover:-translate-y-2 group-hover:-rotate-2 motion-reduce:transform-none motion-reduce:transition-none">
          {t.dateComingSoon}
        </span>
      </div>
    </div>

    <div
      class="mt-10 flex w-[min(68vw,20rem)] flex-col items-stretch gap-2 sm:mt-14 sm:w-auto sm:flex-row sm:items-center sm:gap-10"
      id="waitlist"
    >
      <a
        class="cta-plaque animate-hero-enter bg-[url(/assets/scene/button-primary.svg)] text-base text-cream [animation-delay:390ms] motion-reduce:animate-none sm:w-56 sm:flex-none sm:text-base lg:w-64 lg:text-lg"
        href="https://nocodb.gpul.org/dashboard/#/nc/form/f1137831-84ad-4682-93de-a416cc592ff1"
        target="_blank"
        rel="noopener noreferrer"
      >
        {t.waitlistShort}
      </a>
      <a
        class="cta-plaque animate-hero-enter bg-[url(/assets/scene/button-secondary.svg)] text-base text-ink [animation-delay:460ms] motion-reduce:animate-none sm:w-56 sm:flex-none sm:text-base lg:w-64 lg:text-lg"
        href={sponsorPageUrl}
      >
        {t.sponsor}
      </a>
    </div>
  </div>

  {/* Fills the height left below the CTAs so the hero is always one viewport tall. */}
  <div
    class="relative z-1 -mx-5 mt-10 min-h-40 flex-1 self-stretch"
    aria-hidden="true"
  >
    <div class="absolute top-[26%] left-[-4%] z-4 w-[108%] -rotate-5 animate-hero-enter overflow-hidden bg-cream py-3 text-sm font-black whitespace-nowrap text-ink [animation-delay:500ms] motion-reduce:animate-none sm:top-[38%] lg:text-lg">
      <div class="flex w-max animate-ticker motion-reduce:animate-none">
        <span class="shrink-0 whitespace-nowrap">{t.marquee.repeat(12)}</span>
        <span class="shrink-0 whitespace-nowrap" aria-hidden="true">
          {t.marquee.repeat(12)}
        </span>
      </div>
    </div>
    <img
      class="absolute bottom-0 left-1/2 z-2 aspect-1123/501 h-full max-h-(--building) w-auto max-w-(--building) -translate-x-1/2 animate-hero-scene object-cover object-top [animation-delay:100ms] motion-reduce:animate-none"
      src="/assets/scene/compass_bg.svg"
      alt=""
      width="1123"
      height="1121"
    />
    <div class="absolute inset-x-0 bottom-0 z-3 h-[clamp(14rem,34svh,26rem)] bg-linear-to-b from-transparent to-cream"></div>
  </div>
</section>
