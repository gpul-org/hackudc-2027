---
import { Image } from "astro:assets";
import assetLogoMobileNavy from "@/assets/brand/logo-mobile-navy.svg?url";
import assetLogoNavy from "@/assets/brand/logo-navy.svg?url";
import assetButtonPrimary from "@/assets/scene/button-primary.svg?url";
import assetButtonSecondary from "@/assets/scene/button-secondary.svg?url";
import assetCompassBg from "@/assets/scene/compass_bg.svg?url";
import assetGaviotaAlasAbajo from "@/assets/scene/gaviota-alas-abajo.svg?url";
import assetGaviotaAlasArriba from "@/assets/scene/gaviota-alas-arriba.svg?url";
import assetMascot from "@/assets/scene/mascot.svg?url";
import { copy, type Locale } from "@/i18n/copy";

interface Props {
  locale: Locale;
}

const t = copy[Astro.props.locale];
const sponsorPageUrl =
  Astro.props.locale === "es"
    ? "/sponsors/"
    : `/${Astro.props.locale}/sponsors/`;
---

<section
  class="relative isolate flex min-h-svh flex-col items-center overflow-hidden bg-linear-to-b from-blue via-blue to-cream px-5 pt-[clamp(11rem,27svh,15rem)] text-center max-lg:pt-[clamp(10.5rem,23svh,13rem)] [--building:90vw] [--mobile-logo-width:min(78vw,24rem)] sm:[--building:72vw] lg:[--building:min(62vw,62rem)]"
  id="top"
  aria-labelledby="hero-title"
>
  <div
    class="hero-gull absolute top-[8%] left-0 z-50 w-28 sm:w-32 lg:top-[7%] lg:w-36 cursor-pointer"
    aria-hidden="true"
    id="hero-gull"
    role="button"
    tabindex="0"
    aria-label="Gaviota"
  >
    <Image
      class="hero-gull__frame hero-gull__wings-up"
      src={assetGaviotaAlasArriba}
      alt=""
      width="430"
      height="395"
      decoding="async"
      loading="eager"
    />
    <Image
      class="hero-gull__frame hero-gull__wings-down"
      src={assetGaviotaAlasAbajo}
      alt=""
      width="430"
      height="395"
      decoding="async"
      loading="eager"
    />
  </div>

  <div class="relative z-2 flex flex-col items-center">
    <div class="relative flex flex-col items-center">
      <span class="absolute right-0 bottom-full mb-3 animate-hero-enter bg-red py-1.5 pr-5 pl-6 text-sm font-black tracking-wide text-cream [animation-delay:140ms] [clip-path:polygon(0_0,calc(100%-0.75rem)_0,100%_50%,calc(100%-0.75rem)_100%,0_100%,0.75rem_50%)] motion-reduce:animate-none sm:text-base lg:text-xl">
        {t.edition}
      </span>
      <h1 id="hero-title">
        <picture class="block w-(--mobile-logo-width) sm:w-[min(60vw,56rem,80svh)]">
          <source media="(width < 40rem)" srcset={assetLogoMobileNavy} />
          <Image
            class="w-full animate-hero-logo motion-reduce:animate-none"
            src={assetLogoNavy}
            alt="HackUDC27"
            width="1003"
            height="153"
            fetchpriority="high"
            loading="eager"
          />
        </picture>
        <span class="sr-only">{t.title}</span>
      </h1>

      <p class="mt-5 animate-hero-enter text-sm font-black tracking-wide text-ink [animation-delay:260ms] motion-reduce:animate-none sm:mt-7 sm:text-base">
        {t.dateComingSoon}
      </p>
    </div>

    <div
      class="mt-10 flex w-[min(84vw,24rem)] flex-row items-center gap-2.5 sm:mt-14 sm:w-auto sm:gap-6"
      id="waitlist"
    >
      <a
        style={`background-image: url(${assetButtonPrimary})`}
        class="cta-plaque animate-hero-enter text-xs text-cream [animation-delay:390ms] motion-reduce:animate-none sm:w-56 sm:flex-none sm:text-base lg:w-64 lg:text-lg"
        href="https://nocodb.gpul.org/dashboard/#/nc/form/f1137831-84ad-4682-93de-a416cc592ff1"
        target="_blank"
        rel="noopener noreferrer"
      >
        {t.waitlistShort}
      </a>
      <a
        style={`background-image: url(${assetButtonSecondary})`}
        class="cta-plaque animate-hero-enter text-xs text-blue [animation-delay:460ms] motion-reduce:animate-none sm:w-56 sm:flex-none sm:text-base lg:w-64 lg:text-lg"
        href={sponsorPageUrl}
      >
        {t.sponsor}
      </a>
    </div>
  </div>

  {/* Fills the height left below the CTAs so the hero is always one viewport tall. */}
  <div
    class="relative z-1 -mx-5 mt-2 min-h-40 flex-1 self-stretch"
    aria-hidden="true"
  >
    <div class="absolute top-[26%] left-[-4%] z-4 w-[108%] -rotate-5 animate-hero-enter overflow-hidden bg-cream py-3 text-sm font-black whitespace-nowrap text-ink [animation-delay:500ms] motion-reduce:animate-none sm:top-[38%] lg:text-lg">
      <div class="flex w-max animate-ticker motion-reduce:animate-none">
        <span class="shrink-0 whitespace-nowrap">{t.marquee.repeat(12)}</span>
        <span class="shrink-0 whitespace-nowrap" aria-hidden="true">
          {t.marquee.repeat(12)}
        </span>
      </div>
    </div>
    <a
      class="absolute right-5 bottom-5 z-4 block w-14 transition-transform duration-200 ease-out hover:-translate-y-0.5 active:scale-[0.96] motion-reduce:transform-none motion-reduce:transition-none sm:right-8 sm:bottom-8 sm:w-20"
      href="https://gpul.org"
      aria-label="GPUL"
    >
      <Image
        class="w-full"
        src={assetMascot}
        alt=""
        width="93"
        height="94"
        loading="lazy"
        decoding="async"
      />
    </a>
    <Image
      class="absolute bottom-0 left-1/2 z-2 aspect-1123/501 h-full max-h-(--building) w-auto max-w-(--building) -translate-x-1/2 animate-hero-scene object-cover object-top [animation-delay:100ms] motion-reduce:animate-none"
      src={assetCompassBg}
      alt=""
      width="1123"
      height="1121"
      loading="eager"
    />
    <div class="absolute inset-x-0 bottom-0 z-3 h-[clamp(14rem,34svh,26rem)] bg-linear-to-b from-transparent to-cream"></div>
  </div>
</section>

<script>
  import confetti from "canvas-confetti";

  const gull = document.getElementById("hero-gull");

  function triggerConfetti() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      return;
    }
    const duration = 3 * 1000;
    const end = Date.now() + duration;

    (function frame() {
      confetti({
        particleCount: 7,
        angle: 60,
        spread: 55,
        origin: { x: 0, y: 0.5 },
        colors: ["#002B5C", "#E53E3E", "#F5E6C8", "#FFD700", "#FFFFFF"],
      });
      confetti({
        particleCount: 7,
        angle: 120,
        spread: 55,
        origin: { x: 1, y: 0.5 },
        colors: ["#002B5C", "#E53E3E", "#F5E6C8", "#FFD700", "#FFFFFF"],
      });

      if (Date.now() < end) {
        requestAnimationFrame(frame);
      }
    })();
  }

  gull?.addEventListener("click", triggerConfetti);
  gull?.addEventListener("keydown", (e) => {
    if (e.key === "Enter" || e.key === " ") {
      e.preventDefault();
      triggerConfetti();
    }
  });
</script>

<style>
  .hero-gull {
    aspect-ratio: 430.29 / 395.3;
  }

  .hero-gull__frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: scaleX(-1);
    object-fit: contain;
  }

  .hero-gull__wings-up {
    opacity: 1;
  }

  .hero-gull__wings-down {
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-gull {
      animation:
        gull-flight 18s linear 800ms infinite backwards,
        gull-wave 18s ease-in-out 800ms infinite;
    }

    .hero-gull__wings-up {
      animation: gull-wings-up 420ms steps(1, end) 800ms infinite;
    }

    .hero-gull__wings-down {
      animation: gull-wings-down 420ms steps(1, end) 800ms infinite;
    }

    @keyframes gull-flight {
      from {
        transform: translateX(-100%);
      }

      to {
        transform: translateX(114vw);
      }
    }

    @keyframes gull-wave {
      0% {
        translate: 0 0;
      }

      12% {
        translate: 0 -1svh;
      }

      26% {
        translate: 0 3svh;
      }

      39% {
        translate: 0 1svh;
      }

      52% {
        translate: 0 0;
      }

      65% {
        translate: 0 1svh;
      }

      77% {
        translate: 0 4svh;
      }

      88% {
        translate: 0 9svh;
      }

      100% {
        translate: 0 13svh;
      }
    }

    @keyframes gull-wings-up {
      0%,
      49.99% {
        opacity: 1;
      }

      50%,
      100% {
        opacity: 0;
      }
    }

    @keyframes gull-wings-down {
      0%,
      49.99% {
        opacity: 0;
      }

      50%,
      100% {
        opacity: 1;
      }
    }
  }

  @media (prefers-reduced-motion: no-preference) and (width < 64rem) {
    .hero-gull {
      animation-name: gull-flight, gull-wave-mobile;
      animation-duration: 9s, 9s;
    }

    @keyframes gull-wave-mobile {
      0% {
        translate: 0 0;
      }

      12% {
        translate: 0 -0.5svh;
      }

      26% {
        translate: 0 1.5svh;
      }

      39% {
        translate: 0 0.5svh;
      }

      52% {
        translate: 0 0;
      }

      65% {
        translate: 0 0.5svh;
      }

      77% {
        translate: 0 1.5svh;
      }

      88% {
        translate: 0 4svh;
      }

      100% {
        translate: 0 6svh;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-gull {
      top: 8%;
      left: 50%;
      transform: translateX(-50%);
    }

    .hero-gull__wings-up {
      opacity: 1;
    }

    .hero-gull__wings-down {
      opacity: 0;
    }
  }
</style>
