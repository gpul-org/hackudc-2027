---
import { copy, type Locale } from "@/i18n/copy";

interface Props {
  locale: Locale;
}

const t = copy[Astro.props.locale];
// Coordinates share the facade's cropped viewBox, including when it stretches.
const windows = [
  {
    src: "/assets/scene/sponsors-window-1.svg",
    left: 14.733490566037737,
    top: 46.93546176762661,
    width: 22.60571002979146,
    height: 14.118008937437935,
  },
  {
    src: "/assets/scene/sponsors-window-2.svg",
    left: 38.68008440913604,
    top: 47.133490566037736,
    width: 22.61819761668322,
    height: 14.099935451837139,
  },
  {
    src: "/assets/scene/sponsors-window-3.svg",
    left: 62.6103227408143,
    top: 46.92461767626614,
    width: 22.59966732869911,
    height: 14.098227408143,
  },
  {
    src: "/assets/scene/sponsors-window-4.svg",
    left: 14.72649950347567,
    top: 62.235228401191655,
    width: 22.593331678252234,
    height: 14.095278053624627,
  },
  {
    src: "/assets/scene/sponsors-window-5.svg",
    left: 38.654731876861966,
    top: 62.40275074478648,
    width: 22.632512413108245,
    height: 14.146434955312811,
  },
  {
    src: "/assets/scene/sponsors-window-6.svg",
    left: 62.59723435948361,
    top: 62.199577954319764,
    width: 22.630014895729893,
    height: 14.135690168818272,
  },
];
const tiers = t.sponsorTiers.map(([id, label], index) => ({
  id,
  label,
  top: [5.1, 44.4, 79][index],
}));
const sponsorSlots = [
  { tier: "root", index: 0 },
  ...Array.from({ length: 6 }, (_, index) => ({ tier: "admin", index })),
  ...Array.from({ length: 4 }, (_, index) => ({ tier: "user", index })),
];
---

<div
  class="absolute inset-0 [container-type:inline-size]"
  data-sponsor-building
  data-visit-label={t.sponsorVisit}
>
  <img
    class="absolute inset-0 h-full w-full"
    src="/assets/scene/sponsors-facade.svg"
    width="2014"
    height="2014"
    alt=""
    loading="lazy"
    decoding="async"
  />
  {tiers.map(({ id, label, top }) => (
    <span
      data-tier={id}
      class="pointer-events-none absolute left-1/2 -translate-x-1/2 -translate-y-1/2 font-mono text-[clamp(0.75rem,3.5cqw,1.65rem)] leading-none text-ink"
      style={{ top: `${top}%` }}
    >
      {label}
    </span>
  ))}
  {windows.map((window, index) => (
    <button
      type="button"
      data-sponsor-window
      aria-label={`${t.sponsorWindow} ${index + 1}`}
      class="absolute cursor-pointer rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ink motion-reduce:animate-none"
      style={{
        left: `${window.left}%`,
        top: `${window.top}%`,
        width: `${window.width}%`,
        height: `${window.height}%`,
      }}
    >
      <span
        class="block h-full w-full motion-reduce:animate-none"
        data-window-shake
      >
        <img
          class="block h-full w-full select-none"
          data-window-press
          src={window.src}
          alt=""
          draggable="false"
          loading="lazy"
          decoding="async"
        />
      </span>
    </button>
  ))}
  {sponsorSlots.map(({ tier, index }) => (
    <div data-sponsor-slot data-tier={tier} data-slot-index={index} inert />
  ))}
</div>

<style>
  [data-sponsor-window] {
    z-index: 2;
  }

  [data-sponsor-window][data-falling] {
    z-index: 20;
    transform-origin: center bottom;
  }

  [data-sponsor-slot] {
    position: absolute;
    z-index: 1;
    display: grid;
    place-items: center;
    opacity: 0;
    transform: translateY(12%);
    transition:
      opacity 500ms var(--ease-out),
      transform 500ms var(--ease-out);
    pointer-events: none;
  }

  [data-sponsor-slot][data-visible] {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  [data-sponsor-slot][data-tier="root"] {
    left: 38%;
    top: 14%;
    width: 24%;
    height: 18%;
  }

  [data-sponsor-slot][data-tier="admin"] {
    width: 22%;
    height: 13%;
  }

  [data-sponsor-slot][data-tier="admin"][data-slot-index="0"],
  [data-sponsor-slot][data-tier="admin"][data-slot-index="1"],
  [data-sponsor-slot][data-tier="admin"][data-slot-index="2"] {
    top: 47.5%;
  }
  [data-sponsor-slot][data-tier="admin"][data-slot-index="3"],
  [data-sponsor-slot][data-tier="admin"][data-slot-index="4"],
  [data-sponsor-slot][data-tier="admin"][data-slot-index="5"] {
    top: 62.5%;
  }
  [data-sponsor-slot][data-tier="admin"][data-slot-index="0"],
  [data-sponsor-slot][data-tier="admin"][data-slot-index="3"] {
    left: 15%;
  }
  [data-sponsor-slot][data-tier="admin"][data-slot-index="1"],
  [data-sponsor-slot][data-tier="admin"][data-slot-index="4"] {
    left: 39%;
  }
  [data-sponsor-slot][data-tier="admin"][data-slot-index="2"],
  [data-sponsor-slot][data-tier="admin"][data-slot-index="5"] {
    left: 63%;
  }

  [data-sponsor-slot][data-tier="user"] {
    top: 84%;
    width: 16%;
    height: 12%;
  }

  [data-sponsor-slot][data-tier="user"][data-slot-index="0"] {
    left: 16%;
  }
  [data-sponsor-slot][data-tier="user"][data-slot-index="1"] {
    left: 33%;
  }
  [data-sponsor-slot][data-tier="user"][data-slot-index="2"] {
    left: 50%;
  }
  [data-sponsor-slot][data-tier="user"][data-slot-index="3"] {
    left: 67%;
  }

  [data-sponsor-slot] :global(a),
  [data-sponsor-slot] :global(.sponsor-mark) {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    padding: 2%;
  }

  [data-sponsor-slot] :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  [data-sponsor-slot] :global(.sponsor-name) {
    color: var(--color-ink);
    font-size: clamp(0.5rem, 2cqw, 1rem);
    font-weight: 800;
    text-align: center;
    overflow-wrap: anywhere;
  }

  [data-window-press] {
    transition:
      transform 160ms var(--ease-out),
      opacity 160ms var(--ease-out);
  }

  [data-sponsor-window]:active [data-window-press],
  [data-sponsor-window][data-pressed] [data-window-press] {
    transform: scale(0.96);
    opacity: 0.8;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-sponsor-slot] {
      transform: none;
      transition: opacity 200ms var(--ease-out);
    }
    [data-window-press] {
      transition: none;
    }
    [data-sponsor-window]:active [data-window-press],
    [data-sponsor-window][data-pressed] [data-window-press] {
      transform: none;
    }
  }
</style>

<script>
  import { getSponsors, type Sponsor } from "@/lib/sponsors";

  let controller: AbortController | undefined;
  let observer: IntersectionObserver | undefined;

  document.addEventListener("astro:page-load", () => {
    controller?.abort();
    observer?.disconnect();
    controller = new AbortController();
    const { signal } = controller;
    const building = document.querySelector<HTMLElement>(
      "[data-sponsor-building]",
    );
    if (!building) return;

    const windows = [
      ...building.querySelectorAll<HTMLButtonElement>("[data-sponsor-window]"),
    ];
    const slots = [
      ...building.querySelectorAll<HTMLElement>("[data-sponsor-slot]"),
    ];
    const extras = document.querySelector<HTMLElement>("[data-sponsor-extras]");
    const extrasList = extras?.querySelector<HTMLUListElement>(
      "[data-sponsor-extras-list]",
    );
    const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)");
    const hover = matchMedia("(any-hover: hover) and (any-pointer: fine)");
    const desktop = matchMedia("(min-width: 1024px)");
    const arrow = document.querySelector<SVGSVGElement>("[data-sponsor-arrow]");
    let arrowTimer: number | undefined;
    let arrowAnimations: Animation[] = [];
    const animations = new Map<HTMLButtonElement, Animation>();
    const fallAnimations = new Map<HTMLButtonElement, Animation>();
    const pressTimers = new Map<HTMLButtonElement, number>();
    let timer: number | undefined;
    let visible = false;
    let lastWindow = -1;
    const easing = getComputedStyle(building)
      .getPropertyValue("--ease-out")
      .trim();
    const fallEasing = getComputedStyle(building)
      .getPropertyValue("--ease-in-out")
      .trim();

    function finishFall(button: HTMLButtonElement) {
      fallAnimations.get(button)?.cancel();
      fallAnimations.delete(button);
      button.hidden = true;
      button.removeAttribute("data-falling");
      button.setAttribute("data-revealed", "");
    }

    function revealAdminWindows() {
      if (!visible) return;
      windows.forEach((button, index) => {
        if (
          !button.hasAttribute("data-sponsored") ||
          button.hasAttribute("data-falling") ||
          button.hasAttribute("data-revealed")
        )
          return;
        animations.get(button)?.cancel();
        animations.delete(button);
        if (reduceMotion.matches) {
          finishFall(button);
          return;
        }
        button.setAttribute("data-falling", "");
        const rect = button.getBoundingClientRect();
        const distance = window.innerHeight - rect.top + rect.height + 48;
        const animation = button.animate(
          [
            { transform: "translateY(0) rotate(0deg) scale(1)" },
            {
              transform: "translateY(18px) rotate(-4deg) scale(1.04)",
              offset: 0.18,
            },
            {
              transform: `translateY(${distance}px) rotate(14deg) scale(1.08)`,
            },
          ],
          {
            duration: 1100,
            delay: index * 90,
            easing: fallEasing,
            fill: "forwards",
          },
        );
        fallAnimations.set(button, animation);
        animation.onfinish = () => finishFall(button);
      });
    }

    function renderSponsors(sponsors: Sponsor[]) {
      const groups = new Map([
        ["root", sponsors.filter((sponsor) => sponsor.priority === 1)],
        ["admin", sponsors.filter((sponsor) => sponsor.priority === 2)],
        ["user", sponsors.filter((sponsor) => sponsor.priority === 3)],
      ]);

      slots.forEach((slot) => {
        const tier = slot.dataset.tier!;
        const sponsor = groups.get(tier)?.[Number(slot.dataset.slotIndex)];
        if (!sponsor) {
          slot.replaceChildren();
          slot.removeAttribute("data-visible");
          slot.setAttribute("inert", "");
          delete slot.dataset.sponsorKey;
          if (tier === "admin") {
            const button = windows[Number(slot.dataset.slotIndex)];
            fallAnimations.get(button)?.cancel();
            fallAnimations.delete(button);
            button.hidden = false;
            button.inert = false;
            button.removeAttribute("data-sponsored");
            button.removeAttribute("data-revealed");
            button.removeAttribute("data-falling");
          }
          return;
        }
        const key = JSON.stringify(sponsor);
        if (slot.dataset.sponsorKey === key) return;
        slot.dataset.sponsorKey = key;
        slot.removeAttribute("data-visible");
        if (tier === "admin") {
          const button = windows[Number(slot.dataset.slotIndex)];
          fallAnimations.get(button)?.cancel();
          fallAnimations.delete(button);
          button.hidden = false;
          button.removeAttribute("data-falling");
          button.removeAttribute("data-revealed");
          button.setAttribute("data-sponsored", "");
          button.inert = true;
          if (document.activeElement === button) button.blur();
        }
        const link = document.createElement(sponsor.website ? "a" : "div");
        if (!sponsor.website) {
          link.className = "sponsor-mark";
          link.setAttribute("role", "img");
          link.setAttribute("aria-label", sponsor.name);
        } else {
          link.setAttribute(
            "aria-label",
            `${building.dataset.visitLabel} ${sponsor.name}`,
          );
        }
        if (sponsor.website) {
          const anchor = link as HTMLAnchorElement;
          anchor.href = sponsor.website;
          anchor.target = "_blank";
          anchor.rel = "noopener noreferrer";
        }
        const logo = sponsor.logoUrl ?? sponsor.logoNegativeUrl;
        if (logo) {
          const image = document.createElement("img");
          image.src = logo;
          image.alt = "";
          image.loading = "lazy";
          image.decoding = "async";
          image.addEventListener(
            "error",
            () => {
              const name = document.createElement("span");
              name.className = "sponsor-name";
              name.textContent = sponsor.name;
              image.replaceWith(name);
            },
            { once: true, signal },
          );
          link.append(image);
        } else {
          const name = document.createElement("span");
          name.className = "sponsor-name";
          name.textContent = sponsor.name;
          link.append(name);
        }
        slot.replaceChildren(link);
        slot.style.transitionDelay = `${Number(slot.dataset.slotIndex) * 70}ms`;
        if (visible || reduceMotion.matches) {
          slot.removeAttribute("inert");
          requestAnimationFrame(() => slot.setAttribute("data-visible", ""));
        }
      });
      if (extras && extrasList) {
        const overflow = [
          ...groups.get("root")!.slice(1),
          ...groups.get("admin")!.slice(6),
          ...groups.get("user")!.slice(4),
          ...sponsors.filter(
            (sponsor) => ![1, 2, 3].includes(sponsor.priority),
          ),
        ];
        const key = JSON.stringify(overflow);
        if (extras.dataset.sponsorKey !== key) {
          extras.dataset.sponsorKey = key;
          const items = overflow.map((sponsor) => {
            const item = document.createElement("li");
            const mark = document.createElement(sponsor.website ? "a" : "div");
            if (sponsor.website) {
              const anchor = mark as HTMLAnchorElement;
              anchor.href = sponsor.website;
              anchor.target = "_blank";
              anchor.rel = "noopener noreferrer";
              anchor.setAttribute(
                "aria-label",
                `${building.dataset.visitLabel} ${sponsor.name}`,
              );
            } else {
              mark.className = "sponsor-extra-mark";
              mark.setAttribute("role", "img");
              mark.setAttribute("aria-label", sponsor.name);
            }
            const logo = sponsor.logoUrl ?? sponsor.logoNegativeUrl;
            if (logo) {
              const image = document.createElement("img");
              image.src = logo;
              image.alt = "";
              image.loading = "lazy";
              image.addEventListener(
                "error",
                () => {
                  image.replaceWith(document.createTextNode(sponsor.name));
                },
                { once: true, signal },
              );
              mark.append(image);
            } else {
              mark.textContent = sponsor.name;
            }
            item.append(mark);
            return item;
          });
          extrasList.replaceChildren(...items);
          extras.hidden = overflow.length === 0;
        }
      }
      revealAdminWindows();
    }

    function refreshSponsors() {
      if (document.hidden) return;
      getSponsors(signal)
        .then((sponsors) => {
          if (!signal.aborted) renderSponsors(sponsors);
        })
        .catch((error) => {
          if (!signal.aborted) console.error("Unable to load sponsors", error);
        });
    }

    refreshSponsors();
    const refreshTimer = window.setInterval(refreshSponsors, 5 * 60 * 1000);

    function shake(button: HTMLButtonElement, repeat = false) {
      if (
        reduceMotion.matches ||
        button.hasAttribute("data-sponsored") ||
        button.matches(":active") ||
        button.hasAttribute("data-pressed")
      )
        return;
      const target = button.querySelector<HTMLElement>("[data-window-shake]")!;
      animations.get(button)?.cancel();
      const animation = target.animate(
        [
          { transform: "translateX(0) rotate(0deg)" },
          { transform: "translateX(-2px) rotate(-3deg)", offset: 0.12 },
          { transform: "translateX(2px) rotate(3deg)", offset: 0.26 },
          { transform: "translateX(-2px) rotate(-2.5deg)", offset: 0.4 },
          { transform: "translateX(1px) rotate(2deg)", offset: 0.54 },
          { transform: "translateX(-1px) rotate(-1deg)", offset: 0.68 },
          { transform: "translateX(0) rotate(0deg)", offset: 0.8 },
          { transform: "translateX(0) rotate(0deg)" },
        ],
        // Linear timing preserves every shake; a strong ease-out compressed them.
        { duration: 600, easing: "linear", iterations: repeat ? Infinity : 1 },
      );
      animations.set(button, animation);
      animation.onfinish = () => animations.delete(button);
    }

    function hideArrow() {
      clearTimeout(arrowTimer);
      arrow?.removeAttribute("data-visible");
      arrowAnimations.forEach((animation) => animation.cancel());
      arrowAnimations = [];
    }

    function showArrow() {
      if (!arrow || !desktop.matches) return;
      hideArrow();
      arrow.setAttribute("data-visible", "");
      if (!reduceMotion.matches) {
        arrow
          .querySelectorAll<SVGPathElement>("path")
          .forEach((path, index) => {
            const length = path.getTotalLength();
            arrowAnimations.push(
              path.animate(
                [
                  { strokeDasharray: `${length}`, strokeDashoffset: length },
                  { strokeDasharray: `${length}`, strokeDashoffset: 0 },
                ],
                {
                  duration: index === 0 ? 650 : 180,
                  delay: index === 0 ? 0 : 570,
                  fill: "both",
                  easing,
                },
              ),
            );
          });
      }
      arrowTimer = window.setTimeout(hideArrow, 4500);
    }

    function stopMotion() {
      clearTimeout(timer);
      animations.forEach((animation) => animation.cancel());
      animations.clear();
    }

    function schedule() {
      clearTimeout(timer);
      if (!visible || document.hidden || reduceMotion.matches) return;
      timer = window.setTimeout(
        () => {
          const candidates = windows.filter(
            (button, index) =>
              index !== lastWindow &&
              !button.hasAttribute("data-sponsored") &&
              !button.matches(":hover, :focus, :active"),
          );
          const button =
            candidates[Math.floor(Math.random() * candidates.length)];
          if (button) {
            lastWindow = windows.indexOf(button);
            shake(button);
          }
          schedule();
        },
        3000 + Math.random() * 3000,
      );
    }

    windows.forEach((button) => {
      button.addEventListener(
        "pointerenter",
        (event) => {
          if (hover.matches && event.pointerType !== "touch")
            shake(button, true);
        },
        { signal },
      );
      button.addEventListener(
        "pointerleave",
        () => {
          const animation = animations.get(button);
          if (animation) {
            // Finish the current cycle instead of snapping back mid-shake.
            const elapsed = Number(animation.currentTime ?? 0);
            animation.effect?.updateTiming({
              iterations: Math.floor(elapsed / 600) + 1,
            });
          }
        },
        { signal },
      );
      button.addEventListener(
        "click",
        () => {
          showArrow();
          animations.get(button)?.cancel();
          animations.delete(button);
          clearTimeout(pressTimers.get(button));
          button.setAttribute("data-pressed", "");
          pressTimers.set(
            button,
            window.setTimeout(() => {
              button.removeAttribute("data-pressed");
              pressTimers.delete(button);
            }, 160),
          );
        },
        { signal },
      );
    });

    observer = new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        if (visible) {
          slots.forEach((slot) => {
            if (slot.firstElementChild?.matches("a, .sponsor-mark")) {
              slot.removeAttribute("inert");
              slot.setAttribute("data-visible", "");
            }
          });
          revealAdminWindows();
        }
        if (!visible) stopMotion();
        schedule();
      },
      { threshold: 0.15 },
    );
    observer.observe(building);
    reduceMotion.addEventListener(
      "change",
      () => {
        stopMotion();
        hideArrow();
        if (reduceMotion.matches) {
          windows
            .filter((button) => button.hasAttribute("data-falling"))
            .forEach(finishFall);
        }
        schedule();
      },
      { signal },
    );
    document.addEventListener(
      "visibilitychange",
      () => {
        stopMotion();
        hideArrow();
        schedule();
        if (!document.hidden) refreshSponsors();
      },
      { signal },
    );
    const cleanup = () => {
      stopMotion();
      fallAnimations.forEach((animation) => animation.cancel());
      fallAnimations.clear();
      clearInterval(refreshTimer);
      hideArrow();
      observer?.disconnect();
      pressTimers.forEach(clearTimeout);
      windows.forEach((button) => button.removeAttribute("data-pressed"));
    };
    signal.addEventListener("abort", cleanup, { once: true });
    desktop.addEventListener("change", hideArrow, { signal });
    document.addEventListener("astro:before-swap", () => controller?.abort(), {
      signal,
      once: true,
    });
  });
</script>
