---
import { Image } from "astro:assets";
import assetSponsorsAdminClosed from "@/assets/scene/sponsors-admin-closed.svg?url";
import assetSponsorsAdminTerminal from "@/assets/scene/sponsors-admin-terminal.svg?url";
import assetSponsorsRootDesktop from "@/assets/scene/sponsors-root-desktop.svg?url";
import assetSponsorsRootMobile from "@/assets/scene/sponsors-root-mobile.svg?url";
import assetSponsorsUsersDesktop from "@/assets/scene/sponsors-users-desktop.svg?url";
import assetSponsorsUsersMobile from "@/assets/scene/sponsors-users-mobile.svg?url";
import { copy, type Locale } from "@/i18n/copy";

interface Props {
  locale: Locale;
}

const t = copy[Astro.props.locale];
const adminSlots = Array.from({ length: 6 });
const userSlots = Array.from({ length: 6 });
---

<div
  class="mx-auto w-full max-w-6xl"
  data-sponsor-building
  data-visit-label={t.sponsorVisit}
>
  <div class="relative mx-auto max-w-6xl" data-sponsor-root>
    <picture>
      <source media="(max-width: 639px)" srcset={assetSponsorsRootMobile} />
      <Image
        class="h-auto w-full"
        src={assetSponsorsRootDesktop}
        width="990"
        height="459"
        alt=""
        loading="lazy"
        decoding="async"
      />
    </picture>
    <div
      class="absolute inset-x-[31%] top-[26%] grid h-[30%] place-items-center p-2 sm:inset-x-[36%]"
      data-sponsor-root-slot
    />
  </div>

  <div class="mt-2" data-sponsor-admins>
    <div
      class="grid grid-cols-2 gap-2 sm:grid-cols-[minmax(0,0.5fr)_repeat(3,minmax(0,1fr))_minmax(0,0.5fr)]"
      data-sponsor-admin-grid
    >
      {adminSlots.map((_, index) => (
        <div class="relative aspect-[1.6]" data-sponsor-admin-slot={index}>
          <Image
            class="absolute inset-0 h-full w-full object-fill"
            data-admin-window
            src={assetSponsorsAdminClosed}
            width="223"
            height="139"
            alt=""
            loading="lazy"
            decoding="async"
          />
          <div class="absolute inset-0 z-1" data-sponsor-admin-content />
        </div>
      ))}
      {[1, 2].map((row) => (
        <>
          <Image
            class="h-full w-full self-stretch object-fill"
            data-sponsor-admin-terminal={`left-${row}`}
            src={assetSponsorsAdminTerminal}
            width="119"
            height="139"
            alt=""
            loading="lazy"
            decoding="async"
          />
          <Image
            class="h-full w-full self-stretch object-fill"
            data-sponsor-admin-terminal={`right-${row}`}
            src={assetSponsorsAdminTerminal}
            width="119"
            height="139"
            alt=""
            loading="lazy"
            decoding="async"
          />
        </>
      ))}
    </div>
    <div
      class="mt-3 hidden grid-cols-3 gap-3 sm:grid"
      data-sponsor-admin-overflow
    />
  </div>

  <div class="relative mt-3" data-sponsor-users>
    <picture>
      <source media="(max-width: 639px)" srcset={assetSponsorsUsersMobile} />
      <Image
        class="h-auto w-full"
        src={assetSponsorsUsersDesktop}
        width="969"
        height="217"
        alt=""
        loading="lazy"
        decoding="async"
      />
    </picture>
    <div
      class="absolute inset-x-[7%] top-[12%] grid h-[76%] grid-cols-2 auto-rows-fr gap-x-[6%] gap-y-[5%] overflow-hidden p-[1%] sm:inset-x-[14%] sm:top-[13%] sm:h-[72%] sm:grid-cols-6 sm:gap-x-[2%] sm:gap-y-0"
      data-sponsor-user-slots
    >
      {userSlots.map((_, index) => (
        <div data-sponsor-user-slot={index} />
      ))}
    </div>
    <div
      class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-3"
      data-sponsor-user-overflow
    />
  </div>

  <div class="relative mt-8" data-sponsor-collaborators hidden>
    <h3 class="eyebrow mb-4 text-center">{t.sponsorCollaborators}</h3>
    <picture>
      <source media="(max-width: 639px)" srcset={assetSponsorsUsersMobile} />
      <Image
        class="h-auto w-full"
        src={assetSponsorsUsersDesktop}
        width="969"
        height="217"
        alt=""
        loading="lazy"
        decoding="async"
      />
    </picture>
    <div
      class="absolute inset-x-[7%] top-[calc(12%+2.25rem)] grid h-[calc(76%-2.25rem)] grid-cols-2 auto-rows-fr gap-x-[6%] gap-y-[5%] overflow-hidden p-[1%] sm:inset-x-[4%] sm:top-[calc(13%+2.25rem)] sm:h-[calc(72%-2.25rem)] sm:grid-cols-6 sm:gap-x-[2%] sm:gap-y-0"
      data-sponsor-collaborator-slots
    >
      {userSlots.map((_, index) => (
        <div data-sponsor-collaborator-slot={index} />
      ))}
    </div>
    <div
      class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-3"
      data-sponsor-collaborator-overflow
    />
  </div>
</div>

<style>
  [data-sponsor-admin-terminal] {
    display: none;
  }

  @media (min-width: 640px) {
    [data-sponsor-admin-slot]:nth-child(1) {
      grid-column: 2;
      grid-row: 1;
    }
    [data-sponsor-admin-slot]:nth-child(2) {
      grid-column: 3;
      grid-row: 1;
    }
    [data-sponsor-admin-slot]:nth-child(3) {
      grid-column: 4;
      grid-row: 1;
    }
    [data-sponsor-admin-slot]:nth-child(4) {
      grid-column: 2;
      grid-row: 2;
    }
    [data-sponsor-admin-slot]:nth-child(5) {
      grid-column: 3;
      grid-row: 2;
    }
    [data-sponsor-admin-slot]:nth-child(6) {
      grid-column: 4;
      grid-row: 2;
    }
    [data-sponsor-admin-terminal] {
      display: block;
    }
    [data-sponsor-admin-terminal="left-1"] {
      grid-column: 1;
      grid-row: 1;
    }
    [data-sponsor-admin-terminal="left-2"] {
      grid-column: 1;
      grid-row: 2;
    }
    [data-sponsor-admin-terminal="right-1"] {
      grid-column: 5;
      grid-row: 1;
      transform: scaleX(-1);
    }
    [data-sponsor-admin-terminal="right-2"] {
      grid-column: 5;
      grid-row: 2;
      transform: scaleX(-1);
    }
  }

  [data-sponsor-root-slot] :global(a),
  [data-sponsor-root-slot] :global(.sponsor-mark),
  [data-sponsor-admin-content] :global(a),
  [data-sponsor-admin-content] :global(.sponsor-mark),
  [data-sponsor-user-slot] :global(a),
  [data-sponsor-user-slot] :global(.sponsor-mark),
  [data-sponsor-collaborator-slot] :global(a),
  [data-sponsor-collaborator-slot] :global(.sponsor-mark),
  [data-sponsor-admin-overflow] :global(a),
  [data-sponsor-user-overflow] :global(a) {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    padding: 10%;
  }

  [data-sponsor-root-slot] :global(img),
  [data-sponsor-admin-content] :global(img),
  [data-sponsor-user-slot] :global(img),
  [data-sponsor-collaborator-slot] :global(img),
  [data-sponsor-admin-overflow] :global(img),
  [data-sponsor-user-overflow] :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  [data-sponsor-root-slot] :global(a),
  [data-sponsor-root-slot] :global(.sponsor-mark) {
    padding: 18% 24% 30%;
    transform: translateY(12%);
  }

  [data-sponsor-root-slot] :global(.sponsor-name) {
    font-size: clamp(0.9rem, 2vw, 1.5rem);
  }

  @media (max-width: 639px) {
    [data-sponsor-root-slot] :global(a),
    [data-sponsor-root-slot] :global(.sponsor-mark) {
      padding: 14% 20% 26%;
    }
  }

  [data-sponsor-admin-content] :global(a),
  [data-sponsor-admin-content] :global(.sponsor-mark) {
    padding: 18% 17% 27%;
    transform: translateY(-14%);
  }

  [data-sponsor-user-slot] :global(a),
  [data-sponsor-user-slot] :global(.sponsor-mark) {
    padding: 4%;
  }

  @media (min-width: 640px) {
    [data-sponsor-root-slot] :global(a),
    [data-sponsor-root-slot] :global(.sponsor-mark) {
      transform: translateY(-10%);
    }

    [data-sponsor-user-slot] :global(a),
    [data-sponsor-user-slot] :global(.sponsor-mark) {
      transform: translateX(4%);
    }
  }

  [data-sponsor-admin-overflow] :global(a),
  [data-sponsor-user-overflow] :global(a) {
    min-height: 7rem;
    background: var(--color-cream);
  }

  [data-sponsor-building] :global(.sponsor-name) {
    color: var(--color-ink);
    font-size: clamp(0.55rem, 1.5vw, 1rem);
    font-weight: 800;
    text-align: center;
    overflow-wrap: anywhere;
  }
</style>

<script>
  import assetSponsorsAdminOpened from "@/assets/scene/sponsors-admin-opened.svg?url";
  import assetSponsorsAdminClosed from "@/assets/scene/sponsors-admin-closed.svg?url";
  import { getSponsors, type Sponsor } from "@/lib/sponsors";

  let controller: AbortController | undefined;

  document.addEventListener("astro:page-load", () => {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;
    const building = document.querySelector<HTMLElement>(
      "[data-sponsor-building]",
    );
    if (!building) return;

    const root = building.querySelector<HTMLElement>("[data-sponsor-root]");
    const rootSlot = building.querySelector<HTMLElement>(
      "[data-sponsor-root-slot]",
    );
    const adminSlots = [
      ...building.querySelectorAll<HTMLElement>("[data-sponsor-admin-slot]"),
    ];
    const adminOverflow = building.querySelector<HTMLElement>(
      "[data-sponsor-admin-overflow]",
    );
    const userSlots = [
      ...building.querySelectorAll<HTMLElement>("[data-sponsor-user-slot]"),
    ];
    const userOverflow = building.querySelector<HTMLElement>(
      "[data-sponsor-user-overflow]",
    );
    const collaborators = building.querySelector<HTMLElement>(
      "[data-sponsor-collaborators]",
    );
    const collaboratorSlots = [
      ...building.querySelectorAll<HTMLElement>(
        "[data-sponsor-collaborator-slot]",
      ),
    ];
    const collaboratorOverflow = building.querySelector<HTMLElement>(
      "[data-sponsor-collaborator-overflow]",
    );

    function sponsorMark(sponsor: Sponsor) {
      const mark = document.createElement(sponsor.website ? "a" : "div");
      if (sponsor.website) {
        const anchor = mark as HTMLAnchorElement;
        anchor.href = sponsor.website;
        anchor.target = "_blank";
        anchor.rel = "noopener noreferrer";
        anchor.setAttribute(
          "aria-label",
          `${building.dataset.visitLabel} ${sponsor.name}`,
        );
      } else {
        mark.className = "sponsor-mark";
        mark.setAttribute("role", "img");
        mark.setAttribute("aria-label", sponsor.name);
      }

      const logo = sponsor.logoUrl ?? sponsor.logoNegativeUrl;
      if (!logo) {
        const name = document.createElement("span");
        name.className = "sponsor-name";
        name.textContent = sponsor.name;
        mark.append(name);
        return mark;
      }

      const image = document.createElement("img");
      image.src = logo;
      image.alt = "";
      image.loading = "lazy";
      image.decoding = "async";
      image.addEventListener(
        "error",
        () => {
          const name = document.createElement("span");
          name.className = "sponsor-name";
          name.textContent = sponsor.name;
          image.replaceWith(name);
        },
        { once: true, signal },
      );
      mark.append(image);
      return mark;
    }

    function fillSlots(
      slots: HTMLElement[],
      sponsors: Sponsor[],
      contentSelector?: string,
    ) {
      slots.forEach((slot, index) => {
        const sponsorIndex = Number(slot.dataset.sponsorAdminSlot ?? index);
        const sponsor = sponsors[sponsorIndex];
        const content = contentSelector
          ? slot.querySelector<HTMLElement>(contentSelector)
          : slot;
        content?.replaceChildren(...(sponsor ? [sponsorMark(sponsor)] : []));
        const window = slot.querySelector<HTMLImageElement>(
          "[data-admin-window]",
        );
        if (window)
          window.src = sponsor
            ? assetSponsorsAdminOpened
            : assetSponsorsAdminClosed;
      });
    }

    function fillOverflow(container: HTMLElement | null, sponsors: Sponsor[]) {
      if (!container) return;
      container.replaceChildren(...sponsors.map(sponsorMark));
      container.hidden = sponsors.length === 0;
    }

    function renderSponsors(sponsors: Sponsor[]) {
      const rootSponsors = sponsors.filter((sponsor) => sponsor.priority === 1);
      const adminSponsors = sponsors.filter(
        (sponsor) => sponsor.priority === 2,
      );
      const userSponsors = sponsors.filter((sponsor) => sponsor.priority === 3);
      const collaboratorSponsors = sponsors.filter(
        (sponsor) => sponsor.priority === 4,
      );

      if (root && rootSlot) {
        rootSlot.replaceChildren(...rootSponsors.slice(0, 1).map(sponsorMark));
      }
      fillSlots(adminSlots, adminSponsors, "[data-sponsor-admin-content]");
      fillOverflow(adminOverflow, adminSponsors.slice(adminSlots.length));
      fillSlots(userSlots, userSponsors);
      fillOverflow(userOverflow, userSponsors.slice(userSlots.length));
      if (collaborators)
        collaborators.hidden = collaboratorSponsors.length === 0;
      fillSlots(collaboratorSlots, collaboratorSponsors);
      fillOverflow(
        collaboratorOverflow,
        collaboratorSponsors.slice(collaboratorSlots.length),
      );
    }

    function refreshSponsors() {
      getSponsors(signal)
        .then((sponsors) => {
          if (!signal.aborted) renderSponsors(sponsors);
        })
        .catch((error) => {
          if (!signal.aborted) console.error("Unable to load sponsors", error);
        });
    }

    refreshSponsors();
    const refreshTimer = window.setInterval(refreshSponsors, 5 * 60 * 1000);
    signal.addEventListener("abort", () => clearInterval(refreshTimer), {
      once: true,
    });
    document.addEventListener("astro:before-swap", () => controller?.abort(), {
      signal,
      once: true,
    });
  });
</script>
