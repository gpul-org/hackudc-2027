---
import SponsorBuilding from "@/components/SponsorBuilding.astro";
import { copy, type Locale } from "@/i18n/copy";

interface Props {
  locale: Locale;
}

const t = copy[Astro.props.locale];
---

<section
  class="bg-blue py-16 text-ink lg:py-24"
  id="sponsors"
  aria-labelledby="sponsors-title"
>
  <div class="page-wrap">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow reveal" data-reveal>
        {t.sponsorsKicker}
      </p>
      <h2
        class="display-heading reveal mt-5 text-balance"
        data-reveal
        id="sponsors-title"
      >
        {t.sponsorsTitle}
      </h2>
    </div>
    <div class="reveal mt-10 lg:mt-14" data-reveal>
      <SponsorBuilding locale={Astro.props.locale} />
    </div>
  </div>
</section>
