---
import { Image } from "astro:assets";
import assetLogoNavy from "@/assets/brand/logo-navy.svg?url";
import { copy, languages, type Locale } from "@/i18n/copy";

interface Props {
  locale: Locale;
  localeUrls: Record<Locale, string>;
}

const { locale, localeUrls } = Astro.props;
const t = copy[locale];
const navTargets = ["#about", "#experience", "#sponsors", "#faq"];
const current = languages.find(({ code }) => code === locale)!;
const languageLink =
  "rounded-full px-3.5 py-2 text-sm font-extrabold tracking-wide transition-colors";
const languageOption =
  "grid min-w-0 grid-cols-[0fr] transition-[grid-template-columns] duration-300 ease-out group-focus-within:ms-0.5 group-focus-within:grid-cols-[1fr] group-hover:ms-0.5 group-hover:grid-cols-[1fr] group-data-open:ms-0.5 group-data-open:grid-cols-[1fr] motion-reduce:transition-none";
---

<header
  class="absolute inset-x-0 top-0 z-10 flex items-center justify-between gap-8 px-5 py-4 sm:px-[4vw]"
  data-site-header
>
  <a
    class="inline-flex items-center gap-2"
    href={localeUrls[locale]}
    aria-label="HackUDC27, home"
  >
    <Image
      class="h-6 w-auto sm:h-7"
      src={assetLogoNavy}
      alt=""
      width="1003"
      height="153"
      loading="eager"
    />
  </a>

  <nav class="hidden gap-[2.5vw] lg:flex" aria-label="Primary navigation">
    {t.nav.map((label, index) => (
      <a class="small-link" href={navTargets[index]}>
        {label}
      </a>
    ))}
  </nav>

  <div class="ml-auto flex items-center gap-3">
    <nav
      class="group flex items-center rounded-full border border-transparent p-1 transition-colors duration-300 focus-within:border-ink/30 hover:border-ink/30 data-open:border-ink/30 motion-reduce:transition-none"
      aria-label="Language selector"
      data-header-language-menu
    >
      <div class="flex items-center">
        {languages.map((language) =>
          language.code === locale ? (
            <button
              class={`${languageLink} shrink-0 bg-ink text-cream`}
              type="button"
              aria-label={`Language: ${current.label}`}
              aria-expanded="false"
            >
              {language.label}
            </button>
          ) : (
            <div class={languageOption}>
              <div class="min-w-0 overflow-hidden">
                <a
                  class={`${languageLink} block shrink-0 whitespace-nowrap hover:bg-ink hover:text-cream`}
                  href={localeUrls[language.code]}
                  hreflang={language.code}
                >
                  {language.label}
                </a>
              </div>
            </div>
          ),
        )}
      </div>
    </nav>
    <a
      class="hidden rounded-full bg-ink px-4 py-3 text-xs font-extrabold tracking-wide text-cream transition duration-200 ease-out hover:-translate-y-0.5 hover:bg-red sm:block"
      href="https://nocodb.gpul.org/dashboard/#/nc/form/f1137831-84ad-4682-93de-a416cc592ff1"
      target="_blank"
      rel="noopener noreferrer"
    >
      {t.waitlist}
    </a>
  </div>
</header>

<script>
  let controller: AbortController | undefined;

  document.addEventListener("astro:page-load", () => {
    controller?.abort();

    const menu = document.querySelector<HTMLElement>(
      "[data-header-language-menu]",
    );
    const toggle = menu?.querySelector("button");
    if (!menu || !toggle) return;

    controller = new AbortController();
    const { signal } = controller;
    const setOpen = (open: boolean) => {
      menu.toggleAttribute("data-open", open);
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.addEventListener(
      "click",
      () => setOpen(!menu.hasAttribute("data-open")),
      { signal },
    );
    document.addEventListener(
      "click",
      (event) => {
        if (!menu.contains(event.target as Node)) setOpen(false);
      },
      { signal },
    );
    document.addEventListener(
      "keydown",
      (event) => {
        if (event.key === "Escape") setOpen(false);
      },
      { signal },
    );
  });
</script>
