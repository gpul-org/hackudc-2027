---
import Plus from "@lucide/astro/icons/plus";
import { copy, type Locale } from "@/i18n/copy";

interface Props {
  locale: Locale;
}

const t = copy[Astro.props.locale];
---

<section class="py-28 lg:py-48" id="faq" aria-labelledby="faq-title">
  <div class="page-wrap grid gap-14 sm:grid-cols-[0.9fr_1.1fr] sm:gap-16 lg:gap-36">
    <div class="max-w-4xl">
      <p class="eyebrow reveal" data-reveal>
        {t.faqKicker}
      </p>
      <h2
        class="mt-5 max-w-[12ch] display-heading reveal"
        data-reveal
        id="faq-title"
      >
        {t.faqTitle}
      </h2>
    </div>
    <div class="border-t border-ink/15">
      {t.faq.map(([question, answer]) => (
        <details class="group border-b border-ink/15 py-5 reveal" data-reveal>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-serif text-xl font-medium tracking-tight lg:text-3xl [&::-webkit-details-marker]:hidden">
            <span>{question}</span>
            <span
              class="inline-flex size-7 shrink-0 items-center justify-center rounded-full border border-current font-sans text-xl leading-none transition duration-200 ease-out group-open:rotate-45 group-open:bg-ink group-open:text-cream"
              aria-hidden="true"
            >
              <Plus class="size-4" aria-hidden="true" />
            </span>
          </summary>
          <p class="mt-4 mr-11 max-w-xl text-[0.95rem] leading-normal">
            {answer}
          </p>
        </details>
      ))}
    </div>
  </div>
</section>
