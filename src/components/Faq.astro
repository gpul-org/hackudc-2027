---
import Plus from "@lucide/astro/icons/plus";
import { copy, type Locale } from "@/i18n/copy";

interface Props {
  locale: Locale;
}

const t = copy[Astro.props.locale];
---

<section class="py-16 lg:py-28" id="faq" aria-labelledby="faq-title">
  <div class="page-wrap">
    <div class="mx-auto max-w-4xl text-center">
      <p class="eyebrow reveal" data-reveal>
        {t.faqKicker}
      </p>
      <h2
        class="mx-auto mt-5 max-w-[14ch] display-heading reveal"
        data-reveal
        id="faq-title"
      >
        {t.faqTitle}
      </h2>
    </div>

    <div class="mt-16 grid grid-cols-1 gap-x-8 gap-y-0 sm:grid-cols-2 lg:grid-cols-3 lg:gap-x-10">
      {t.faq.map(([question, answer]) => (
        <details class="group border-t border-ink/15 py-5 reveal" data-reveal>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 select-none font-serif text-xl leading-[1.15] font-normal tracking-[-0.01em] sm:text-2xl [&::-webkit-details-marker]:hidden">
            <span>{question}</span>
            <span
              class="inline-flex size-7 shrink-0 items-center justify-center rounded-full border border-current font-sans text-xl leading-none transition duration-200 ease-out group-open:rotate-45 group-open:bg-ink group-open:text-cream"
              aria-hidden="true"
            >
              <Plus class="size-4" aria-hidden="true" />
            </span>
          </summary>
          <p class="mt-4 mr-11 max-w-xl text-[0.95rem] leading-[1.6]">
            {answer}
          </p>
        </details>
      ))}
    </div>
  </div>
</section>
