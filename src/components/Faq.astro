---
import { getRelativeLocaleUrl } from "astro:i18n";
import FaqItem from "@/components/FaqItem.astro";
import { copy, type Locale } from "@/i18n/copy";

interface Props {
  locale: Locale;
}

const t = copy[Astro.props.locale];
const questions = [...t.organizationFaq, ...t.faq];
const midpoint = Math.ceil(questions.length / 2);
const columns = [questions.slice(0, midpoint), questions.slice(midpoint)];
// Answers may carry Markdown-style links: [label](href).
const creditsPolicyUrl =
  "https://sede.udc.gal/services/electronic_board/EXP2026/006159/document?documentCsv=DJ01GM3IEGSLN3U132D9497H&logicalId=0405c945-9fe6-4cc2-a94f-250a0dac40c6";
const uscAulaProfesionalUrl =
  "https://www.usc.gal/gl/centro/escola-tecnica-superior-enxenaria/aula-profesional";
// Answers support `[label](href)` links and `**bold**`, plain strong like the terms in the Markdown pages.
const tokenPattern = /\[([^\]]+)\]\(([^)]+)\)|\*\*([^*]+)\*\*/g;
type AnswerPart = string | { label: string; href: string } | { bold: string };
const parseAnswer = (answer: string) => {
  answer = answer.replaceAll(
    "{manifestoUrl}",
    getRelativeLocaleUrl(Astro.props.locale, "manifesto"),
  );
  answer = answer.replaceAll(
    "{mentorsUrl}",
    getRelativeLocaleUrl(Astro.props.locale, "mentors/"),
  );
  answer = answer.replaceAll("{creditsPolicyUrl}", creditsPolicyUrl);
  answer = answer.replaceAll("{uscAulaProfesionalUrl}", uscAulaProfesionalUrl);
  const parts: AnswerPart[] = [];
  let end = 0;
  for (const match of answer.matchAll(tokenPattern)) {
    parts.push(
      answer.slice(end, match.index),
      match[3] === undefined
        ? { label: match[1], href: match[2] }
        : { bold: match[3] },
    );
    end = match.index + match[0].length;
  }
  return [...parts, answer.slice(end)];
};
---

<section
  class="pt-16 pb-20 lg:pt-28 lg:pb-32"
  id="faq"
  aria-labelledby="faq-title"
>
  <div class="page-wrap">
    <div class="mx-auto max-w-4xl text-center">
      <h2
        class="mx-auto mt-5 max-w-[14ch] display-heading reveal"
        data-reveal
        id="faq-title"
      >
        {t.faqTitle}
      </h2>
    </div>

    <div
      class="mt-16 grid grid-cols-1 items-start gap-x-8 lg:grid-cols-2"
      data-faq-accordion
    >
      {columns.map((questions) => (
        <div class="contents lg:flex lg:flex-col">
          {questions.map(([question, answer]) => (
            <FaqItem question={question} reveal>
              {answer.split("\n\n").map((paragraph) => (
                <p class="mt-4 mr-11 max-w-xl text-[0.95rem] leading-[1.6]">
                  {parseAnswer(paragraph).map((part) =>
                    typeof part === "string" ? (
                      part
                    ) : "bold" in part ? (
                      <strong>{part.bold}</strong>
                    ) : (
                      <a
                        class="whitespace-nowrap underline decoration-1 underline-offset-4 transition-colors hover:text-red"
                        href={part.href}
                      >
                        {part.label}
                      </a>
                    ),
                  )}
                </p>
              ))}
            </FaqItem>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>
