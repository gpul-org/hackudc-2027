---
import Plus from "@lucide/astro/icons/plus";
import { copy, type Locale } from "@/i18n/copy";

interface Props {
  locale: Locale;
}

const t = copy[Astro.props.locale];
const midpoint = Math.ceil(t.faq.length / 2);
const columns = [t.faq.slice(0, midpoint), t.faq.slice(midpoint)];
---

<section
  class="pt-16 pb-20 lg:pt-28 lg:pb-32"
  id="faq"
  aria-labelledby="faq-title"
>
  <div class="page-wrap">
    <div class="mx-auto max-w-4xl text-center">
      <p class="eyebrow reveal" data-reveal>
        {t.faqKicker}
      </p>
      <h2
        class="mx-auto mt-5 max-w-[14ch] display-heading reveal"
        data-reveal
        id="faq-title"
      >
        {t.faqTitle}
      </h2>
    </div>

    <div
      class="mt-16 grid grid-cols-1 items-start gap-x-8 lg:grid-cols-2"
      data-faq-accordion
    >
      {columns.map((questions) => (
        <div class="contents lg:flex lg:flex-col">
          {questions.map(([question, answer]) => (
            <details
              class="group border-t border-ink/15 py-5 reveal motion-reduce:animate-none"
              data-reveal
              data-faq-item
            >
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 select-none font-serif text-xl leading-[1.15] font-normal tracking-[-0.01em] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-red sm:text-2xl [&::-webkit-details-marker]:hidden">
                <span>{question}</span>
                <span
                  class="faq-icon inline-flex size-7 shrink-0 items-center justify-center rounded-full border border-current font-sans text-xl leading-none"
                  aria-hidden="true"
                >
                  <Plus class="size-4" aria-hidden="true" />
                </span>
              </summary>
              <div data-faq-answer>
                <p class="mt-4 mr-11 max-w-xl text-[0.95rem] leading-[1.6]">
                  {answer}
                </p>
              </div>
            </details>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-icon {
    transition:
      transform 200ms var(--ease-out),
      background-color 200ms var(--ease-out),
      color 200ms var(--ease-out);
  }

  details[open]:not([data-expanded="false"]) .faq-icon {
    transform: rotate(45deg);
    background-color: var(--color-ink);
    color: var(--color-cream);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-icon {
      transition: none;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const controller = new AbortController();
    const { signal } = controller;
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
    const animations = new Map<HTMLDetailsElement, Animation>();
    const easing = getComputedStyle(document.documentElement)
      .getPropertyValue("--ease-out")
      .trim();

    const setOpen = (
      item: HTMLDetailsElement,
      open: boolean,
      animate: boolean,
    ) => {
      const startHeight = item.getBoundingClientRect().height;
      animations.get(item)?.cancel();
      animations.delete(item);
      item.dataset.expanded = String(open);
      const answer = item.querySelector<HTMLElement>("[data-faq-answer]")!;
      answer.inert = !open;

      if (!animate || reducedMotion.matches) {
        item.open = open;
        item.style.overflow = "";
        return;
      }

      // Measure both native states so the final height stays responsive.
      item.open = open;
      const endHeight = item.getBoundingClientRect().height;
      item.open = true;
      item.style.overflow = "hidden";
      const animation = item.animate(
        { height: [`${startHeight}px`, `${endHeight}px`] },
        { duration: 200, easing },
      );
      animations.set(item, animation);
      animation.onfinish = () => {
        item.open = open;
        item.style.overflow = "";
        animations.delete(item);
      };
    };

    document
      .querySelectorAll<HTMLElement>("[data-faq-accordion]")
      .forEach((accordion) => {
        accordion
          .querySelectorAll<HTMLDetailsElement>("[data-faq-item]")
          .forEach((item) => {
            const summary = item.querySelector("summary")!;
            summary.addEventListener(
              "click",
              (event) => {
                event.preventDefault();
                const open = item.dataset.expanded
                  ? item.dataset.expanded !== "true"
                  : !item.open;
                const animate = event.detail > 0;
                if (open) {
                  accordion
                    .querySelectorAll<HTMLDetailsElement>("details[open]")
                    .forEach((other) => {
                      if (other !== item) setOpen(other, false, animate);
                    });
                }
                setOpen(item, open, animate);
              },
              { signal },
            );
          });
      });

    reducedMotion.addEventListener(
      "change",
      () => {
        if (reducedMotion.matches)
          animations.forEach((animation) => animation.finish());
      },
      { signal },
    );

    document.addEventListener(
      "astro:before-swap",
      () => {
        controller.abort();
        animations.forEach((animation) => animation.cancel());
        animations.clear();
      },
      { once: true, signal },
    );
  });
</script>
