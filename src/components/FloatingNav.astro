---
import { languages, type Locale } from "@/i18n/copy";

interface Props {
  locale: Locale;
  localeUrls: Record<Locale, string>;
}

const { locale, localeUrls } = Astro.props;
const current = languages.find(({ code }) => code === locale)!;
const languageLink =
  "rounded-full px-3.5 py-2 text-sm font-extrabold tracking-wide transition-colors";
const languageOption =
  "grid min-w-0 grid-cols-[0fr] transition-[grid-template-columns] duration-300 ease-out group-focus-within:ms-0.5 group-focus-within:grid-cols-[1fr] group-hover:ms-0.5 group-hover:grid-cols-[1fr] group-data-open:ms-0.5 group-data-open:grid-cols-[1fr] motion-reduce:transition-none";
---

<!-- Desktop only. Shown once the hero has scrolled out of view. -->
<nav
  class="invisible fixed top-4 left-1/2 z-30 flex max-lg:hidden -translate-x-1/2 -translate-y-4 items-center gap-6 rounded-full bg-cream/90 p-1 pl-7 opacity-0 shadow-sm backdrop-blur transition-[opacity,translate,visibility] duration-300 ease-out data-visible:visible data-visible:translate-y-0 data-visible:opacity-100 sm:top-6"
  aria-label="Site navigation"
  data-floating-nav
>
  <a href="#top" aria-label="HackUDC27, back to top">
    <img
      class="h-6 w-auto sm:h-7"
      src="/assets/brand/logo-navy.svg"
      alt=""
      width="1003"
      height="153"
    />
  </a>

  <!-- Only the current language shows; the rest slide out on hover, focus or tap. -->
  <div
    class="group flex items-center rounded-full border border-transparent p-1 transition-colors duration-300 focus-within:border-ink/30 hover:border-ink/30 data-open:border-ink/30 motion-reduce:transition-none"
    data-language-menu
  >
    <div class="flex items-center">
      {languages.map((language) =>
        language.code === locale ? (
          <button
            class={`${languageLink} shrink-0 bg-ink text-cream`}
            type="button"
            aria-label={`Language: ${current.label}`}
            aria-expanded="false"
          >
            {language.label}
          </button>
        ) : (
          <div class={languageOption}>
            <div class="min-w-0 overflow-hidden">
              <a
                class={`${languageLink} block shrink-0 whitespace-nowrap hover:bg-ink hover:text-cream`}
                href={localeUrls[language.code]}
                hreflang={language.code}
                data-floating-language
              >
                {language.label}
              </a>
            </div>
          </div>
        ),
      )}
    </div>
  </div>
</nav>

<script>
  const scrollPositionKey = "hackudc:floating-language-scroll";
  let observer: IntersectionObserver | undefined;
  let controller: AbortController | undefined;

  const currentRoute = () =>
    `${window.location.pathname}${window.location.search}${window.location.hash}`;

  const rememberScrollPosition = (link: HTMLAnchorElement) => {
    const destination = new URL(link.href, window.location.href);

    try {
      sessionStorage.setItem(
        scrollPositionKey,
        JSON.stringify({
          route: `${destination.pathname}${destination.search}${destination.hash}`,
          left: window.scrollX,
          top: window.scrollY,
        }),
      );
    } catch {
      // Ignore storage restrictions; navigation should still work normally.
    }
  };

  const restoreScrollPosition = () => {
    try {
      const stored = sessionStorage.getItem(scrollPositionKey);
      if (!stored) return;

      sessionStorage.removeItem(scrollPositionKey);
      const position = JSON.parse(stored) as {
        route?: unknown;
        left?: unknown;
        top?: unknown;
      };

      if (
        position.route !== currentRoute() ||
        typeof position.left !== "number" ||
        typeof position.top !== "number"
      ) {
        return;
      }

      window.scrollTo({
        left: position.left,
        top: position.top,
        behavior: "instant",
      });
    } catch {
      // Ignore malformed or unavailable session storage.
    }
  };

  document.addEventListener("astro:page-load", () => {
    restoreScrollPosition();
    observer?.disconnect();
    controller?.abort();

    const nav = document.querySelector("[data-floating-nav]");
    const hero = document.querySelector("#top");
    const menu = document.querySelector<HTMLElement>("[data-language-menu]");
    const toggle = menu?.querySelector("button");
    if (!nav || !hero || !menu || !toggle) return;

    observer = new IntersectionObserver(([entry]) =>
      nav.toggleAttribute("data-visible", !entry.isIntersecting),
    );
    observer.observe(hero);

    // Touch screens have no hover, so a tap on the current language opens the rest.
    controller = new AbortController();
    const { signal } = controller;
    const languageLinks = menu.querySelectorAll<HTMLAnchorElement>(
      "[data-floating-language]",
    );
    const setOpen = (open: boolean) => {
      menu.toggleAttribute("data-open", open);
      toggle.setAttribute("aria-expanded", String(open));
    };

    languageLinks.forEach((link) => {
      link.addEventListener(
        "click",
        (event) => {
          if (
            event.button !== 0 ||
            event.metaKey ||
            event.ctrlKey ||
            event.shiftKey ||
            event.altKey
          ) {
            return;
          }

          rememberScrollPosition(link);
        },
        { signal },
      );
    });

    document.addEventListener("astro:after-swap", restoreScrollPosition, {
      signal,
    });

    toggle.addEventListener(
      "click",
      () => setOpen(!menu.hasAttribute("data-open")),
      { signal },
    );
    document.addEventListener(
      "click",
      (event) => {
        if (!menu.contains(event.target as Node)) setOpen(false);
      },
      { signal },
    );
    document.addEventListener(
      "keydown",
      (event) => {
        if (event.key === "Escape") setOpen(false);
      },
      { signal },
    );
  });
</script>
