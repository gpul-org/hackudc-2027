    download: "Descargar dossier completo",
    downloadNote: "PDF · Paquetes de patrocinio 2027",
    why: "¿Por qué patrocinar HackUDC?",
    benefits: [
      ["437", "hackers en la última edición"],
      ["+30", "ciudades españolas"],
      ["91%", "entre 19 y 24 años"],
      ["21", "edad mediana"],
    ],
    reasons: [
      [
        "Marca y comunidad",
        "Sitúa a tu empresa en el centro de la comunidad tecnológica gallega mediante stands, charlas, talleres e interacción directa.",
      ],
      [
        "Selección de talento",
        "Conoce a estudiantes antes de que entren al mercado laboral. Participantes de ediciones anteriores encontraron prácticas y empleo a través de HackUDC.",
