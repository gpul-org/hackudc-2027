const t = content[locale];
const siteCopy = copy[locale];

const no = "—";
const packages = [
  {
    name: "</root>",
    price: "7.000€",
    summary: siteCopy.sponsorPackageSummaries[0][1],
    highlights: siteCopy.sponsorPackageHighlights[0][1],
    details: [
      "~6",
      "+1",
      t.sizeL,
      t.yes,
      t.sizeXL,
      t.yes,
      t.yes,
      "2 × 1 h",
      t.yes,
    ],
  },
  {
    name: "</admin>",
    price: "3.500€",
    summary: siteCopy.sponsorPackageSummaries[1][1],
    highlights: siteCopy.sponsorPackageHighlights[1][1],
    details: ["~4", "1", t.sizeM, t.yes, t.sizeL, t.yes, t.yes, "1 h", t.yes],
  },
  {
    name: "</user>",
    price: "1.000€",
    summary: siteCopy.sponsorPackageSummaries[2][1],
    highlights: siteCopy.sponsorPackageHighlights[2][1],
    details: ["~2", no, no, no, t.sizeM, no, t.yes, "30 min", t.yes],
  },
  {
    name: "</collab>",
    price: "In-kind",
    summary: siteCopy.sponsorPackageSummaries[3][1],
    highlights: siteCopy.sponsorPackageHighlights[3][1],
    details: [no, no, no, no, t.sizeS, no, t.yes, no, no],
  },
];
const features = [
  t.tickets,
  t.challenge,
  t.stand,
  t.cv,
  t.website,
  t.signage,
  t.social,
  t.talks,
  t.swag,
];
---

<main class="min-h-dvh bg-cream text-ink">
  <PageHeader
    locale={locale}
    localeUrls={localeUrls}
    homeUrl={homeUrl}
    backLabel={t.back}
    backShortLabel={t.backShort}
  />

  <section class="page-wrap pt-4 pb-24" aria-labelledby="sponsors-title">
    <p class="eyebrow text-sm text-red">{t.kicker}</p>
    <div class="mt-6 grid gap-10 lg:grid-cols-[1.25fr_0.75fr] lg:items-end">
      <div>
        <h1 id="sponsors-title" class="display-heading max-w-[11ch]">
          {t.title}
        </h1>
        <p class="mt-8 max-w-xl text-pretty text-lg leading-snug sm:text-xl">
          {t.intro}
        </p>
      </div>
      <div class="grid gap-3">
        <button
          class="flex min-h-14 items-center justify-between gap-5 rounded-full border-2 border-ink px-6 py-3 text-left transition duration-200 ease-out hover:-translate-y-0.5 hover:border-red hover:text-red"
          type="button"
          data-copy-email="hackudc@gpul.org"
          data-copy-label={siteCopy.sponsorCopyEmail}
          data-copied-label={siteCopy.sponsorEmailCopied}
        >
          <span class="text-sm font-black" data-copy-label aria-live="polite">
            {siteCopy.sponsorCopyEmail}
          </span>
          <Mail class="size-5 shrink-0" aria-hidden="true" />
        </button>
        <a
          class="group flex min-h-14 items-center justify-between gap-5 rounded-full bg-ink px-6 py-3 text-cream transition duration-200 ease-out hover:-translate-y-0.5 hover:bg-red"
          href="/assets/documents/HackUDC2027-Dossier.pdf"
          download
        >
          <span>
            <span class="block text-sm font-black">{t.download}</span>
            <span class="mt-0.5 block text-xs">{t.downloadNote}</span>
          </span>
          <Download
            class="size-5 shrink-0 transition group-hover:translate-y-0.5"
            aria-hidden="true"
          />
        </a>
      </div>
    </div>
  </section>

  <section
    class="border-y border-ink/20 bg-ink text-cream"
    aria-labelledby="why-title"
  >
    <div class="page-wrap py-20 lg:py-28">
      <p class="eyebrow text-blue">{t.stats}</p>
      <h2 id="why-title" class="display-heading mt-5 max-w-[12ch]">
        {t.why}
      </h2>
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {t.benefits.map(([number, label]) => (
          <div class="border-t-4 border-blue pt-4">
            <strong class="block font-serif text-5xl leading-none text-blue tabular-nums">
              {number}
            </strong>
            <span class="mt-3 block max-w-[15ch] text-sm font-bold leading-snug">
              {label}
            </span>
          </div>
        ))}
      </div>
      <div class="mt-20 grid gap-10 lg:grid-cols-3">
        {t.reasons.map(([title, body]) => (
          <article>
            <h3 class="font-serif text-2xl text-blue">{title}</h3>
            <p class="mt-4 max-w-sm text-pretty leading-snug">{body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="page-wrap py-20 lg:py-28" aria-labelledby="packages-title">
    <p class="eyebrow text-sm text-red">HackUDC 2027</p>
    <h2 id="packages-title" class="display-heading mt-5">
      {t.packages}
    </h2>
    <div class="mt-12 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
      {packages.map((pkg) => (
        <article class="flex flex-col border-2 border-ink p-6">
          <h3 class="font-serif text-3xl">{pkg.name}</h3>
          <p class="mt-4 text-4xl font-black tabular-nums text-red">
            {pkg.price}
          </p>
          <p class="mt-6 min-h-24 text-pretty leading-snug text-ink/70">
            {pkg.summary}
          </p>
          <ul class="mt-8 space-y-2 border-t border-ink/20 pt-5 text-sm font-bold">
            {pkg.highlights.map((highlight) => (
              <li>{highlight}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
    <details class="mt-8 border-y border-ink/20">
      <summary class="cursor-pointer py-5 font-black text-red marker:text-ink">
        <span class="ml-2 inline-flex flex-col gap-1 align-middle sm:inline-flex">
          <span>{siteCopy.sponsorDetails}</span>
          <span class="font-normal text-sm text-ink/70">
            {siteCopy.sponsorDetailsSummary}
          </span>
        </span>
      </summary>
      <div class="overflow-x-auto border-t border-ink/20">
        <table class="w-full min-w-180 border-collapse text-left text-sm">
          <caption class="sr-only">{siteCopy.sponsorDetailsCaption}</caption>
          <thead class="border-b border-ink/20 text-xs text-ink/70">
            <tr>
              <th class="px-4 py-4 font-bold" scope="col">
                &nbsp;
              </th>
              {packages.map((pkg) => (
                <th class="px-4 py-4 font-bold" scope="col">
                  {pkg.name}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {features.map((feature, index) => (
              <tr class="border-b border-ink/15 last:border-0">
                <th class="px-4 py-4 font-bold" scope="row">
                  {feature}
                </th>
                {packages.map((pkg) => (
                  <td class="px-4 py-4 text-ink/70">{pkg.details[index]}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>
    <p class="mt-6 text-sm text-ink/70">{t.taxes}</p>
    <aside class="mt-12 grid gap-6 border-2 border-ink p-6 sm:grid-cols-[1fr_auto] sm:items-center">
      <div>
        <h3 class="font-serif text-3xl text-balance">
          {siteCopy.sponsorContactTitle}
        </h3>
        <p class="mt-3 max-w-2xl text-pretty leading-snug">
          {siteCopy.sponsorContactBody}
        </p>
      </div>
      <button
        class="inline-flex min-h-12 items-center justify-center rounded-full bg-ink px-6 py-3 text-sm font-black text-cream transition duration-200 ease-out hover:-translate-y-0.5 hover:bg-red"
        type="button"
        data-copy-email="hackudc@gpul.org"
        data-copy-label={siteCopy.sponsorCopyEmail}
        data-copied-label={siteCopy.sponsorEmailCopied}
      >
        <span data-copy-label aria-live="polite">
          {siteCopy.sponsorCopyEmail}
        </span>
      </button>
    </aside>
  </section>
</main>

<SiteFooter locale={locale} />

<script>
  let copyController: AbortController | undefined;

  document.addEventListener("astro:page-load", () => {
    copyController?.abort();
    copyController = new AbortController();
    const { signal } = copyController;

    async function copyText(value: string) {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(value);
        return;
      }

      const input = document.createElement("textarea");
      input.value = value;
      input.style.position = "fixed";
      input.style.opacity = "0";
      document.body.append(input);
      input.select();
      const copied = document.execCommand("copy");
      input.remove();
      if (!copied) throw new Error("Unable to copy email");
    }

    document
      .querySelectorAll<HTMLButtonElement>("[data-copy-email]")
      .forEach((button) => {
        const label = button.querySelector<HTMLElement>("[data-copy-label]");
        const email = button.dataset.copyEmail;
        const defaultLabel = button.dataset.copyLabel;
        const copiedLabel = button.dataset.copiedLabel;
        let resetTimer: number | undefined;

        if (!label || !email || !defaultLabel || !copiedLabel) return;

        button.addEventListener(
          "click",
          async () => {
            try {
              await copyText(email);
              window.clearTimeout(resetTimer);
              label.textContent = copiedLabel;
              resetTimer = window.setTimeout(() => {
                label.textContent = defaultLabel;
              }, 2000);
            } catch (error) {
              console.error("Unable to copy sponsor email", error);
            }
          },
          { signal },
        );
      });
  });
</script>
