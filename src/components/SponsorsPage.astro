    cv: "Acceso a CV de hackers",
    website: "Logo en la web",
    signage: "Logo en la señalética",
    social: "Mención en redes",
    talks: "Charlas y talleres",
    swag: "Merchandising en las bolsas",
    taxes: "Impuestos y premios de los retos no incluidos en el precio.",
    contact: "¿Listos para colaborar?",
    contactBody:
      "Cuéntanos qué te gustaría construir con la comunidad de HackUDC.",
    email: "Escribir a hackudc@gpul.org",
  },
  en: {
    back: "Back to HackUDC",
    kicker: "Sponsorship · HackUDC 2027",
    title: "Let’s build Galicia’s tech future.",
    intro:
      "For our fifth edition, we will bring 500 hackers together for 36 hours at the Faculty of Computer Science in A Coruña.",
    download: "Download the full deck",
    downloadNote: "PDF · 2027 sponsorship packages",
    why: "Why sponsor HackUDC?",
    benefits: [
      ["437", "hackers last edition"],
      ["+30", "Spanish cities"],
      ["91%", "aged 19-24"],
      ["21", "median age"],
    ],
    reasons: [
      [
        "Brand and community",
        "Put your company at the heart of Galicia’s tech community through stands, talks, workshops and direct interaction.",
      ],
      [
        "Recruiting",
        "Meet talented students before they enter the job market. Past participants have found internships and jobs through HackUDC.",
      ],
      [
        "Build with us",
        "Bring a real challenge, mentor teams and see what hundreds of hackers can build in 36 hours.",
      ],
    ],
    packages: "Sponsorship packages",
    tickets: "Event tickets with meals",
    challenge: "Propose a challenge",
    stand: "Stand at the event",
    cv: "Access to hacker CVs",
    website: "Logo on the website",
    signage: "Logo on event signage",
    social: "Social media shoutout",
    talks: "Talks and workshops",
    swag: "Company swag in bags",
    taxes: "Taxes and challenge prizes are not included in the price.",
    contact: "Ready to partner?",
    contactBody:
      "Tell us what you would like to build with the HackUDC community.",
    email: "Email hackudc@gpul.org",
  },
  gl: {
    back: "Volver a HackUDC",
    kicker: "Patrocinio · HackUDC 2027",
    title: "Construamos o futuro tecnolóxico de Galicia.",
    intro:
      "Na nosa quinta edición reuniremos 500 hackers durante 36 horas na Facultade de Informática da Coruña.",
    download: "Descargar o dossier completo",
    downloadNote: "PDF · Paquetes de patrocinio 2027",
    why: "Por que patrocinar HackUDC?",
    benefits: [
      ["437", "hackers na última edición"],
      ["+30", "cidades españolas"],
      ["91%", "entre 19 e 24 anos"],
      ["21", "idade mediana"],
    ],
    reasons: [
      [
        "Marca e comunidade",
        "Sitúa a túa empresa no centro da comunidade tecnolóxica galega mediante stands, charlas, obradoiros e interacción directa.",
      ],
      [
        "Selección de talento",
        "Coñece estudantes antes de que entren no mercado laboral. Participantes de edicións anteriores atoparon prácticas e emprego a través de HackUDC.",
