    website: "Logo na web",
    signage: "Logo na sinalética",
    social: "Mención en redes",
    talks: "Charlas e obradoiros",
    swag: "Merchandising nas bolsas",
    taxes: "Os impostos e os premios dos retos non están incluídos no prezo.",
    contact: "Listos para colaborar?",
    contactBody:
      "Cóntanos que che gustaría construír coa comunidade de HackUDC.",
    email: "Escribir a hackudc@gpul.org",
  },
} as const;
const t = content[locale];

const packages = [
  {
    name: "</root>",
    price: "7.000€",
    details: [
      "~6",
      "+1",
      "Grande",
      "Sí",
      "Más grande",
      "Sí",
      "Sí",
      "2 × 1 h",
      "Sí",
    ],
  },
  {
    name: "</admin>",
    price: "3.500€",
    details: ["~4", "1", "Regular", "Sí", "Grande", "Sí", "Sí", "1 h", "Sí"],
  },
  {
    name: "</user>",
    price: "1.000€",
    details: ["~2", "—", "—", "—", "Regular", "—", "Sí", "30 min", "Sí"],
  },
  {
    name: "</collab>",
    price: "In-kind",
    details: ["—", "—", "—", "—", "Pequeño", "—", "Sí", "—", "—"],
  },
];
const features = [
  t.tickets,
  t.challenge,
  t.stand,
  t.cv,
  t.website,
  t.signage,
  t.social,
  t.talks,
  t.swag,
];
---

<main class="min-h-dvh bg-red text-cream">
  <header class="page-wrap flex items-center justify-between py-5 sm:py-7">
    <a
      class="inline-flex min-h-11 items-center gap-2 text-xs font-black tracking-wide uppercase hover:text-blue"
      href={homeUrl}
    >
      <ArrowLeft class="size-4" aria-hidden="true" />
      {t.back}
    </a>
    <img
      class="h-7 w-auto sm:h-9"
      src="/assets/brand/logo-cream.svg"
      alt="HackUDC27"
      width="1003"
      height="153"
    />
  </header>

  <section
    class="page-wrap pt-16 pb-24 sm:pt-24 lg:pt-32"
    aria-labelledby="sponsors-title"
  >
    <p class="eyebrow text-sm text-blue">{t.kicker}</p>
    <div class="mt-6 grid gap-10 lg:grid-cols-[1.25fr_0.75fr] lg:items-end">
      <div>
        <h1 id="sponsors-title" class="display-heading max-w-[11ch] text-cream">
          {t.title}
        </h1>
        <p class="mt-8 max-w-xl text-pretty text-lg leading-snug sm:text-xl">
          {t.intro}
        </p>
      </div>
      <a
        class="group flex min-h-14 items-center justify-between gap-5 rounded-full bg-cream px-6 py-3 text-ink transition duration-200 ease-out hover:-translate-y-0.5 hover:bg-blue"
        href="/assets/documents/HackUDC2027-Dosier.pdf"
        download
      >
        <span>
          <span class="block text-sm font-black">{t.download}</span>
          <span class="mt-0.5 block text-xs">{t.downloadNote}</span>
        </span>
        <Download
          class="size-5 shrink-0 transition group-hover:translate-y-0.5"
          aria-hidden="true"
        />
      </a>
    </div>
  </section>

  <section
    class="border-y border-cream/30 bg-cream text-ink"
    aria-labelledby="why-title"
  >
    <div class="page-wrap py-20 lg:py-28">
      <p class="eyebrow text-red">HackUDC en cifras</p>
      <h2 id="why-title" class="display-heading mt-5 max-w-[12ch]">
        {t.why}
      </h2>
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {t.benefits.map(([number, label]) => (
          <div class="border-t-4 border-red pt-4">
            <strong class="block font-serif text-5xl leading-none text-red tabular-nums">
              {number}
            </strong>
            <span class="mt-3 block max-w-[15ch] text-sm font-bold leading-snug">
              {label}
            </span>
          </div>
        ))}
      </div>
      <div class="mt-20 grid gap-10 lg:grid-cols-3">
        {t.reasons.map(([title, body]) => (
          <article>
            <h3 class="font-serif text-2xl text-red">{title}</h3>
            <p class="mt-4 max-w-sm text-pretty leading-snug">{body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="page-wrap py-20 lg:py-28" aria-labelledby="packages-title">
    <p class="eyebrow text-sm text-blue">HackUDC 2027</p>
    <h2 id="packages-title" class="display-heading mt-5">
      {t.packages}
    </h2>
    <div class="mt-12 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
      {packages.map((pkg) => (
        <article class="flex flex-col border-2 border-cream p-6">
          <h3 class="font-serif text-3xl">{pkg.name}</h3>
          <p class="mt-4 text-4xl font-black tabular-nums text-blue">
            {pkg.price}
          </p>
          <dl class="mt-8 space-y-3 border-t border-cream/30 pt-5 text-sm">
            {features.map((feature, index) => (
              <div class="grid grid-cols-[1fr_auto] gap-3">
                <dt>{feature}</dt>
                <dd class="font-bold text-blue">{pkg.details[index]}</dd>
              </div>
            ))}
          </dl>
        </article>
      ))}
    </div>
    <p class="mt-6 text-sm text-cream/80">{t.taxes}</p>
  </section>

  <section class="border-t border-cream/30 bg-ink">
    <div class="page-wrap grid gap-8 py-16 sm:grid-cols-[1fr_auto] sm:items-center">
      <div>
        <p class="eyebrow text-sm text-blue">HackUDC · GPUL</p>
        <h2 class="mt-4 font-serif text-4xl text-balance sm:text-5xl">
          {t.contact}
        </h2>
        <p class="mt-4 max-w-xl text-pretty leading-snug">{t.contactBody}</p>
      </div>
      <a
        class="inline-flex min-h-12 items-center justify-center rounded-full bg-cream px-6 py-3 text-sm font-black text-ink transition duration-200 ease-out hover:-translate-y-0.5 hover:bg-blue"
        href="mailto:hackudc@gpul.org"
      >
        {t.email}
      </a>
    </div>
  </section>
</main>
