---
import { copy, type Locale } from "@/i18n/copy";

interface Props {
  locale: Locale;
}

const t = copy[Astro.props.locale];

// One photo per step, in the same order as `t.steps`.
const images = [
  "/img/how_to_team.webp",
  "/img/how_to_challenge.webp",
  "/img/how_to_coding.webp",
  "/img/how_to_presentation.webp",
];
const steps = t.steps.map(([number, title, body], index) => ({
  number,
  title,
  body,
  image: images[index],
}));
const total = String(steps.length).padStart(2, "0");
---

<!-- When everything fits on screen, the script sets `data-pinned`: the section
     grows to about one screen of scroll per step, the stage sticks for one
     screen and the steps stack in place. Otherwise everything stays in normal
     flow. -->
<section
  id="steps"
  class="bg-cream pinned:h-[310svh] lg:pinned:h-[400svh]"
  aria-labelledby="steps-title"
  data-steps
>
  <div
    class="page-wrap py-16 pinned:sticky pinned:top-0 pinned:flex pinned:h-svh pinned:flex-col pinned:pb-24 lg:pt-24 lg:pinned:pb-16"
    data-steps-stage
  >
    <header>
      <p class="eyebrow">{t.stepsKicker}</p>
      <h2 id="steps-title" class="mt-4 display-heading">
        {t.stepsTitle}
      </h2>
    </header>

    <!-- `--rose` is the rose's size; the panel reads it to tuck under the rose.
         Pinned, the row is a size container, so the rose and the panel grow
         into whatever height the heading leaves (`cqh`) instead of guessing it
         from the viewport. -->
    <div
      class="relative mt-6 flex flex-col items-center [--rose:min(70%,20rem)] pinned:min-h-0 pinned:flex-1 pinned:[container-type:size] pinned:[--rose:min(70cqw,22rem,45cqh)] lg:mt-10 lg:flex-row lg:[--rose:min(26rem,28vw)] lg:pinned:[--rose:min(88cqh,36rem)]"
      data-steps-row
    >
      <!-- Below desktop the panel slides out from under the rose. On desktop
           the rose leaves the flow and only its right half shows, on top of
           the panel's left edge: the half the steps turn towards. -->
      <div
        class="pointer-events-none relative z-1 w-(--rose) flex-none lg:absolute lg:inset-y-0 lg:left-0 lg:flex lg:w-[calc(var(--rose)/2)] lg:items-center lg:justify-end lg:overflow-hidden"
        aria-hidden="true"
      >
        <img
          class="block h-auto w-full lg:h-full lg:max-h-(--rose) lg:w-auto lg:max-w-none lg:flex-none"
          data-steps-rose
          src="/assets/scene/rosa-ventos.svg"
          alt=""
          width="1057"
          height="1054"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="relative -mt-[calc(var(--rose)*0.2)] flex flex-col justify-center self-stretch overflow-hidden bg-ink px-6 pt-[calc(var(--rose)*0.2+1.75rem)] pb-7 text-cream pinned:flex-1 lg:m-0 lg:flex-1 lg:self-center lg:p-10 lg:pl-[calc(var(--rose)/2+2.5rem)] lg:pinned:min-h-[calc(var(--rose)*0.8)]">
        <div class="grid gap-8">
          {steps.map(({ number, title, body, image }) => (
            <article
              class="max-lg:text-center pinned:[grid-area:1/1]"
              data-step
            >
              <div class="relative z-1 lg:w-1/2">
                <p class="eyebrow text-yellow">
                  {number} <span class="text-cream/40">/ {total}</span>
                </p>
                <h3 class="mt-4 font-serif text-3xl leading-tight max-[30rem]:text-[clamp(1.5rem,7vw,2rem)] max-[30rem]:wrap-anywhere sm:text-4xl">
                  {title}
                </h3>
                <p class="mt-5 max-w-sm text-base leading-relaxed max-lg:mx-auto max-[30rem]:mt-4 sm:text-lg">
                  {body}
                </p>
              </div>
              <!-- Pinned desktop only: the photo fades in from the panel's
                     ink and swaps with its step. -->
              <img
                class="pointer-events-none absolute inset-y-0 right-0 hidden h-full w-[45%] object-cover mask-[linear-gradient(to_right,transparent,black_70%)] lg:pinned:block"
                src={image}
                alt=""
                width="1200"
                height="900"
                loading="lazy"
                decoding="async"
              />
            </article>
          ))}
        </div>

        <div
          class="relative z-1 mt-8 flex gap-2 max-lg:justify-center"
          aria-hidden="true"
        >
          {steps.map(() => (
            <span
              class="h-0.75 w-8 bg-cream opacity-25 data-active:bg-yellow data-active:opacity-100"
              data-step-marker
            />
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Each step turns the rose one eighth, so a point of the star lands on the
  // panel's arrow. It only turns while the text crossfades, between 0.35 and
  // 0.65 of the way to the next step, and holds still otherwise.
  const STEP_ANGLE = 45;
  const TURN_START = 0.35;
  const TURN_END = 0.65;

  const clamp01 = (value: number) => Math.min(1, Math.max(0, value));

  function roseAngle(position: number) {
    const step = Math.floor(position);
    const t = clamp01((position - step - TURN_START) / (TURN_END - TURN_START));
    // Smoothstep, so each turn eases in and out of its locked angle.
    return (step + t * t * (3 - 2 * t)) * STEP_ANGLE;
  }

  // Fully shown up to 0.35 steps away and gone by 0.55, so two neighbouring
  // steps crossfade over the same window the rose turns in.
  const stepOpacity = (distance: number) => clamp01((0.55 - distance) / 0.2);

  document.addEventListener("astro:page-load", () => {
    const section = document.querySelector<HTMLElement>("[data-steps]");
    const stage = section?.querySelector<HTMLElement>("[data-steps-stage]");
    const row = section?.querySelector<HTMLElement>("[data-steps-row]");
    const rose = section?.querySelector<HTMLElement>("[data-steps-rose]");
    if (!section || !stage || !row || !rose) return;

    const steps = [...section.querySelectorAll<HTMLElement>("[data-step]")];
    const markers = [
      ...section.querySelectorAll<HTMLElement>("[data-step-marker]"),
    ];
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
    const controller = new AbortController();
    const { signal } = controller;
    let frame = 0;
    let pinned = false;

    // 0 when the stage sticks, 1 when it lets go.
    const scrollProgress = () =>
      clamp01(
        -section.getBoundingClientRect().top /
          Math.max(1, section.offsetHeight - stage.offsetHeight),
      );

    // Pins on trial and measures: if the tallest step (they all keep their
    // box while stacked) pushes the panel past the row, the screen is too
    // short and the steps go back to normal flow instead of being cut off.
    // Only runs when the layout can change, never on scroll.
    const measure = () => {
      section.toggleAttribute("data-pinned", !reducedMotion.matches);
      pinned = !reducedMotion.matches && row.scrollHeight <= row.clientHeight;
      section.toggleAttribute("data-pinned", pinned);
    };

    const update = () => {
      frame = 0;

      const position = pinned ? scrollProgress() * (steps.length - 1) : 0;
      const current = Math.round(position);
      rose.style.transform = `rotate(${roseAngle(position)}deg)`;

      steps.forEach((step, index) => {
        const active = !pinned || index === current;
        const opacity = pinned ? stepOpacity(Math.abs(position - index)) : 1;
        step.style.opacity = pinned ? String(opacity) : "";
        // A step stays painted until it has fully faded out, but only the
        // current one is reachable by keyboard and assistive tech.
        step.style.visibility = opacity > 0 ? "" : "hidden";
        step.inert = !active;
        markers[index]?.toggleAttribute("data-active", active);
      });
    };

    const requestUpdate = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };
    const remeasure = () => {
      measure();
      requestUpdate();
    };

    window.addEventListener("scroll", requestUpdate, { passive: true, signal });
    window.addEventListener("resize", remeasure, { signal });
    reducedMotion.addEventListener("change", remeasure, { signal });
    // Web fonts change the text's height once they load.
    document.fonts.ready.then(() => signal.aborted || remeasure());
    document.addEventListener(
      "astro:before-swap",
      () => {
        controller.abort();
        cancelAnimationFrame(frame);
      },
      { once: true, signal },
    );
    measure();
    update();
  });
</script>
