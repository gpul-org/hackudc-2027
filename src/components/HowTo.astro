---
import { Image } from "astro:assets";
import assetRosaVentos from "@/assets/scene/rosa-ventos.webp";
import photoTeam from "@/assets/photos/how_to_team.webp";
import photoChallenge from "@/assets/photos/how_to_challenge.webp";
import photoCoding from "@/assets/photos/how_to_coding.webp";
import photoPresentation from "@/assets/photos/how_to_presentation.webp";
import { copy, type Locale } from "@/i18n/copy";

interface Props {
  locale: Locale;
}

const t = copy[Astro.props.locale];

// One photo per step, in the same order as `t.steps`.
const images = [photoTeam, photoChallenge, photoCoding, photoPresentation];
const steps = t.steps.map(([number, title, body], index) => ({
  number,
  title,
  body,
  image: images[index],
}));
const total = String(steps.length).padStart(2, "0");
---

<!-- When everything fits on screen, the script sets `data-pinned`: the section
     grows to about one screen of scroll per step, the stage sticks for one
     screen and the steps stack in place. Otherwise everything stays in normal
     flow. -->
<section
  id="steps"
  class="bg-cream pinned:h-[200svh] lg:pinned:h-[260svh]"
  aria-labelledby="steps-title"
  data-steps
>
  <div
    class="page-wrap py-16 pinned:sticky pinned:top-0 pinned:flex pinned:h-svh pinned:flex-col pinned:pb-24 lg:pt-24 lg:pinned:pb-16"
    data-steps-stage
  >
    <!-- Keep the headline and stage as one composition on ultrawide displays,
         rather than letting the photo panel span the entire available canvas. -->
    <div class="flex min-h-0 w-full flex-1 flex-col lg:mx-auto lg:max-w-[68.75rem]">
      <header>
        <h2 id="steps-title" class="display-heading">
          {t.stepsTitle}
        </h2>
      </header>

      <!-- `--rose` is the rose's size; the panel reads it to tuck under the rose.
         Pinned, the row is a size container, so the rose and the panel grow
         into whatever height the heading leaves (`cqh`) instead of guessing it
         from the viewport. -->
      <div
        class="relative mt-6 flex flex-col items-center max-sm:bg-ink pinned:min-h-0 pinned:flex-1 pinned:[container-type:size] sm:flex-row sm:[--rose:min(20rem,25vw)] sm:pinned:[--rose:min(88cqh,25vw)] lg:mt-10 lg:[--rose:min(26rem,28vw)] lg:pinned:[--rose:min(88cqh,36rem)]"
        data-steps-row
      >
        <div class="h-(--photo) flex-none sm:hidden" aria-hidden="true" />
        <div
          class="pointer-events-none absolute inset-x-0 top-0 h-(--photo) overflow-hidden sm:hidden"
          aria-hidden="true"
        >
          {steps.map(({ image }, index) => (
            <Image
              class="absolute inset-0 h-full w-full object-cover mask-[linear-gradient(to_bottom,var(--color-ink)_45%,transparent)]"
              data-step-photo
              style={`opacity: ${index === 0 ? 1 : 0}`}
              src={image}
              widths={[400, 800, 1200]}
              sizes="100vw"
              alt=""
              width="1200"
              height="900"
              loading="lazy"
              decoding="async"
            />
          ))}
        </div>
        <!-- In the side-by-side layout, the rose overlaps the panel by half. -->
        <div
          class="pointer-events-none relative z-1 w-(--rose) flex-none overflow-hidden max-sm:-mt-[calc(var(--rose)/2)] max-sm:h-[calc(var(--rose)/2)] sm:absolute sm:inset-y-0 sm:left-0 sm:flex sm:w-[calc(var(--rose)/2)] sm:items-center sm:justify-end"
          aria-hidden="true"
        >
          <Image
            class="block h-auto w-full sm:h-full sm:max-h-(--rose) sm:w-auto sm:max-w-none sm:flex-none"
            data-steps-rose
            src={assetRosaVentos}
            widths={[480, 960, 1440]}
            sizes="(min-width: 1024px) 576px, (min-width: 640px) 25vw, 260px"
            alt=""
            width="1440"
            height="1440"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div
          data-steps-panel
          class="relative flex flex-col justify-center self-stretch overflow-clip bg-ink px-6 pt-7 pb-7 text-cream max-sm:bg-transparent sm:flex-1 sm:self-center sm:py-6 sm:pl-[calc(var(--rose)/2+1.5rem)] sm:pinned:min-h-[calc(var(--rose)*0.8)] lg:p-10 lg:pl-[calc(var(--rose)/2+2.5rem)]"
        >
          <div class="grid gap-8">
            {steps.map(({ number, title, body, image }) => (
              <article
                class="max-sm:text-center pinned:[grid-area:1/1]"
                data-step
              >
                <div class="relative z-1 sm:w-[55%] lg:w-1/2">
                  <p class="eyebrow text-yellow">
                    {number} <span class="text-cream/40">/ {total}</span>
                  </p>
                  <h3 class="mt-4 font-serif text-3xl leading-tight max-[30rem]:text-[clamp(1.5rem,7vw,2rem)] max-[30rem]:wrap-anywhere lg:text-4xl">
                    {title}
                  </h3>
                  <p class="mt-5 max-w-sm text-base leading-relaxed max-sm:mx-auto max-[30rem]:mt-4 lg:text-lg">
                    {body}
                  </p>
                </div>
                <!-- In the pinned side-by-side layout, the photo fades in from the panel's
                     ink and swaps with its step. -->
                <Image
                  class="pointer-events-none absolute inset-y-0 right-0 hidden h-full w-2/5 object-cover mask-[linear-gradient(to_right,transparent,var(--color-ink)_70%)] sm:pinned:block lg:w-[45%]"
                  src={image}
                  widths={[400, 800, 1200]}
                  sizes="(min-width: 1024px) 500px, 40vw"
                  alt=""
                  width="1200"
                  height="900"
                  loading="lazy"
                  decoding="async"
                />
              </article>
            ))}
          </div>

          <div
            class="relative z-1 mt-8 flex gap-2 max-sm:justify-center"
            data-step-markers
            aria-hidden="true"
          >
            {steps.map(() => (
              <span
                class="h-0.75 w-8 bg-cream opacity-25 data-active:bg-yellow data-active:opacity-100"
                data-step-marker
              />
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  [data-steps][data-pinned] [data-steps-row] {
    touch-action: pan-y pinch-zoom;
  }

  @media (width < 40rem) {
    /* The mobile card keeps its content height, even on tall viewports. */
    [data-steps-row] {
      --photo: clamp(12rem, calc(38svh - 5rem), 18rem);
      --rose: min(80vw, 16.25rem);
    }
    [data-steps][data-pinned] [data-steps-row] {
      flex: none;
      container-type: normal;
    }
    [data-steps-panel] {
      padding-top: 0.75rem;
      padding-bottom: 2.5rem;
    }
  }

  @media (width < 64rem) and (height <= 36rem) {
    [data-steps][data-pinned] [data-steps-stage] {
      padding-block: 1.5rem 4.5rem;
    }
    [data-steps][data-pinned] #steps-title {
      font-size: 1.875rem;
    }
    [data-steps][data-pinned] [data-steps-row] {
      margin-top: 1rem;
    }
    [data-steps][data-pinned] [data-steps-panel] {
      padding-block: 1rem;
    }
    [data-pinned] [data-step] h3,
    [data-pinned] [data-step] h3 + p,
    [data-pinned] [data-step-markers] {
      margin-top: 0.75rem;
    }
  }

  @media (width < 40rem) and (height <= 36rem) {
    [data-steps][data-pinned] [data-steps-row] {
      --photo: 9rem;
    }
  }
</style>

<script>
  // Each step turns the rose one eighth, so a point of the star lands on the
  // panel's arrow. It only turns while the text crossfades, between 0.3 and
  // 0.7 of the way to the next step, and holds still otherwise.
  const STEP_ANGLE = 45;
  const TURN_START = 0.3;
  const TURN_END = 0.7;
  const ROSE_SCALE = 1.2;

  const clamp01 = (value: number) => Math.min(1, Math.max(0, value));

  function roseAngle(position: number) {
    const step = Math.floor(position);
    const t = clamp01((position - step - TURN_START) / (TURN_END - TURN_START));
    // Smoothstep, so each turn eases in and out of its locked angle.
    return (step + t * t * (3 - 2 * t)) * STEP_ANGLE;
  }

  // Crossfade matches the rose turn window (0.3–0.7) for more scroll per step.
  const stepOpacity = (distance: number) =>
    clamp01((TURN_END - distance) / (TURN_END - TURN_START));

  document.addEventListener("astro:page-load", () => {
    const section = document.querySelector<HTMLElement>("[data-steps]");
    const stage = section?.querySelector<HTMLElement>("[data-steps-stage]");
    const row = section?.querySelector<HTMLElement>("[data-steps-row]");
    const rose = section?.querySelector<HTMLElement>("[data-steps-rose]");
    if (!section || !stage || !row || !rose) return;

    const steps = [...section.querySelectorAll<HTMLElement>("[data-step]")];
    const photos = [
      ...section.querySelectorAll<HTMLElement>("[data-step-photo]"),
    ];
    const markers = [
      ...section.querySelectorAll<HTMLElement>("[data-step-marker]"),
    ];
    const wideLayout = matchMedia("(min-width: 640px)");
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
    const controller = new AbortController();
    const { signal } = controller;
    let frame = 0;
    let settleTimer = 0;
    let pinned = false;
    let touch: {
      id: number;
      x: number;
      y: number;
      dragging: boolean;
      scroll: number;
      minScroll: number;
      maxScroll: number;
      scrollPerPixel: number;
    } | null = null;

    const scrollDistance = () =>
      Math.max(1, section.offsetHeight - stage.offsetHeight);

    // 0 when the stage sticks, 1 when it lets go.
    const scrollProgress = () =>
      clamp01(-section.getBoundingClientRect().top / scrollDistance());

    const settleStep = () => {
      if (!pinned || touch?.dragging) return;

      const offset = -section.getBoundingClientRect().top;
      const distance = scrollDistance();
      // Leave the rest of the page free to scroll past the first and last steps.
      if (offset <= 0 || offset >= distance) return;

      const stepDistance = distance / (steps.length - 1);
      const correction =
        Math.round(offset / stepDistance) * stepDistance - offset;
      if (Math.abs(correction) > 1) {
        window.scrollBy({ top: correction, behavior: "smooth" });
      }
    };

    // Pins on trial and measures: if the tallest step (they all keep their
    // box while stacked) pushes the panel past the row, the screen is too
    // short and the steps go back to normal flow instead of being cut off.
    // Only runs when the layout can change, never on scroll.
    const measure = () => {
      section.toggleAttribute("data-pinned", !reducedMotion.matches);
      pinned =
        !reducedMotion.matches &&
        row.scrollHeight <= row.clientHeight &&
        (wideLayout.matches || stage.scrollHeight <= stage.clientHeight);
      section.toggleAttribute("data-pinned", pinned);
    };

    const update = () => {
      frame = 0;

      const position = pinned ? scrollProgress() * (steps.length - 1) : 0;
      const current = Math.round(position);
      rose.style.transform = `scale(${wideLayout.matches ? ROSE_SCALE : 1}) rotate(${reducedMotion.matches ? 0 : roseAngle(position)}deg)`;

      steps.forEach((step, index) => {
        const active = !pinned || index === current;
        const opacity = pinned ? stepOpacity(Math.abs(position - index)) : 1;
        step.style.opacity = pinned ? String(opacity) : "";
        photos[index].style.opacity = String(
          pinned ? opacity : index === 0 ? 1 : 0,
        );
        // A step stays painted until it has fully faded out, but only the
        // current one is reachable by keyboard and assistive tech.
        step.style.visibility = opacity > 0 ? "" : "hidden";
        step.inert = !active;
        markers[index]?.toggleAttribute("data-active", active);
      });
    };

    const requestUpdate = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };
    const remeasure = () => {
      touch = null;
      measure();
      requestUpdate();
    };

    row.addEventListener(
      "pointerdown",
      (event) => {
        if (!pinned || event.pointerType !== "touch") return;
        if (!event.isPrimary) {
          touch = null;
          return;
        }

        const scroll = window.scrollY;
        const start = scroll + section.getBoundingClientRect().top;
        const distance = scrollDistance();
        const pixelsPerStep = row.clientWidth / 2;
        touch = {
          id: event.pointerId,
          x: event.clientX,
          y: event.clientY,
          dragging: false,
          scroll,
          minScroll: Math.min(scroll, start),
          maxScroll: Math.max(scroll, start + distance),
          // A swipe across half the card advances one step, like vertical scroll.
          scrollPerPixel: distance / (steps.length - 1) / pixelsPerStep,
        };
      },
      { signal },
    );
    row.addEventListener(
      "pointermove",
      (event) => {
        if (!touch || event.pointerId !== touch.id) return;
        const dx = touch.x - event.clientX;
        if (!touch.dragging) {
          if (
            Math.abs(dx) < 12 ||
            Math.abs(dx) < Math.abs(event.clientY - touch.y) * 1.5
          )
            return;
          touch.dragging = true;
          row.setPointerCapture(event.pointerId);
        }

        // Both gestures update the same page position so they can be alternated.
        touch.scroll = Math.min(
          touch.maxScroll,
          Math.max(touch.minScroll, touch.scroll + dx * touch.scrollPerPixel),
        );
        touch.x = event.clientX;
        window.scrollTo({ top: touch.scroll, behavior: "instant" });
      },
      { signal },
    );
    const endTouch = (event: PointerEvent) => {
      if (event.pointerId !== touch?.id) return;
      const wasDragging = touch.dragging;
      touch = null;
      if (wasDragging) settleStep();
    };
    row.addEventListener("pointerup", endTouch, { signal });
    row.addEventListener("pointercancel", endTouch, { signal });

    window.addEventListener("scroll", requestUpdate, { passive: true, signal });
    if ("onscrollend" in document) {
      document.addEventListener("scrollend", settleStep, { signal });
    } else {
      // Older browsers need a quiet period after both touch input and momentum.
      let fingerDown = false;
      const scheduleSettle = () => {
        clearTimeout(settleTimer);
        if (pinned && !fingerDown) {
          settleTimer = window.setTimeout(settleStep, 150);
        }
      };
      const trackFingers = (event: TouchEvent) => {
        fingerDown = event.touches.length > 0;
        scheduleSettle();
      };
      window.addEventListener("scroll", scheduleSettle, {
        passive: true,
        signal,
      });
      window.addEventListener("touchstart", trackFingers, {
        passive: true,
        signal,
      });
      window.addEventListener("touchend", trackFingers, {
        passive: true,
        signal,
      });
      window.addEventListener("touchcancel", trackFingers, {
        passive: true,
        signal,
      });
    }
    window.addEventListener("resize", remeasure, { signal });
    reducedMotion.addEventListener("change", remeasure, { signal });
    // Web fonts change the text's height once they load.
    document.fonts.ready.then(() => signal.aborted || remeasure());
    document.addEventListener(
      "astro:before-swap",
      () => {
        controller.abort();
        cancelAnimationFrame(frame);
        clearTimeout(settleTimer);
      },
      { once: true, signal },
    );
    measure();
    update();
  });
</script>
