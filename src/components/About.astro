---
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import Play from "@lucide/astro/icons/play";
import { copy, type Locale } from "@/i18n/copy";

interface Props {
  locale: Locale;
}

const t = copy[Astro.props.locale];
const cardTopline =
  "flex justify-between px-1.5 pt-1 pb-3 text-[0.68rem] font-black tracking-wider uppercase";
const cardCaption =
  "absolute bottom-3 left-3 inline-flex items-center gap-1 text-xs font-black tracking-wide uppercase";
---

<section
  class="relative pt-16 pb-40 sm:pb-72 lg:pt-28"
  id="about"
  aria-labelledby="about-title"
>
  <div
    class="absolute right-4 bottom-10 flex items-end gap-3 sm:right-8 sm:gap-4 lg:right-[max(1rem,calc(50%-35rem))]"
    data-scroll-drift
  >
    <a
      class="inline-flex items-center gap-2 border-b border-current pb-1.5 text-xs font-black tracking-wide uppercase transition-colors hover:text-red"
      href="/assets/manifesto.pdf"
      download="hackudc-manifesto.pdf"
    >
      {t.manifestoCta}
      <ArrowUpRight class="size-3.5" aria-hidden="true" />
    </a>
    <img
      class="w-16 opacity-95 sm:w-24"
      src="/assets/scene/mascot.svg"
      alt=""
      width="93"
      height="94"
    />
  </div>
  <img
    class="absolute bottom-0 -left-16 hidden w-36 origin-bottom -rotate-4 opacity-30 sm:block sm:-left-20 sm:w-56 sm:opacity-90 lg:left-[max(-8rem,calc(50%-44rem))]"
    src="/assets/scene/farola.svg"
    alt=""
    width="706"
    height="742"
    data-scroll-drift
  />
  <div class="page-wrap">
    <div class="mt-9 grid gap-10 sm:grid-cols-[1.1fr_0.9fr] sm:gap-16 lg:gap-24">
      <div class="max-w-4xl">
        <p class="eyebrow text-red reveal" data-reveal>
          {t.aboutLabel}
        </p>
        <h2
          class="mt-4 max-w-[12ch] display-heading reveal"
          data-reveal
          data-leading-punctuation={t.aboutTitle.startsWith("¿") ? "true" : undefined}
          id="about-title"
        >
          {t.aboutTitle}
        </h2>
      </div>
      <div class="max-w-sm pb-1.5 text-base leading-[1.6] sm:max-w-md lg:text-xl">
        <p class="reveal" data-reveal>
          {t.aboutBody}
        </p>
        <p
          class="mt-5 max-w-sm text-[0.95rem] leading-[1.6] text-ink/70 reveal"
          data-reveal
        >
          {t.aboutDetail}
        </p>
        <a
          class="mt-8 inline-flex gap-3 border-b border-current pb-1.5 text-xs font-black tracking-widest uppercase reveal"
          data-reveal
          href="#experience"
        >
          {t.nav[1]} <span aria-hidden="true">↘</span>
        </a>
      </div>
    </div>
  </div>
</section>

<section
  class="bg-blue py-24 lg:py-40"
  id="experience"
  aria-labelledby="experience-title"
>
  <div class="page-wrap">
    <div class="max-w-4xl">
      <p class="eyebrow text-ink reveal" data-reveal>
        {t.experienceKicker}
      </p>
      <h2
        class="mt-5 max-w-[12ch] display-heading reveal"
        data-reveal
        id="experience-title"
      >
        {t.experienceTitle}
      </h2>
      <p
        class="reveal mt-8 max-w-md text-base leading-[1.55] lg:text-xl"
        data-reveal
      >
        {t.experienceBody}
      </p>
    </div>

    <div class="mt-14 grid gap-4 sm:mt-24 sm:grid-cols-[1.05fr_0.95fr] sm:gap-[3vw] lg:mt-30">
      <article class="border-2 border-ink bg-cream p-3 reveal" data-reveal>
        <div class={cardTopline}>
          <span>{t.gallery}</span>
          <span>01</span>
        </div>
        <div class="relative aspect-[1.55] overflow-hidden bg-blue">
          <img
            class="absolute bottom-0 left-[5%] w-[90%]"
            src="/assets/scene/building-wide.svg"
            alt=""
            width="990"
            height="459"
          />
          <span class={cardCaption}>
            {t.galleryCta}
            <ArrowUpRight class="size-3.5" aria-hidden="true" />
          </span>
        </div>
      </article>
      <article
        class="ml-[8%] self-end border-2 border-ink bg-ink p-3 text-cream sm:-mb-20 sm:ml-0 reveal"
        data-reveal
      >
        <div class={cardTopline}>
          <span>{t.aftermovie}</span>
          <span>02</span>
        </div>
        <div class="relative flex aspect-[1.55] items-center justify-center bg-ink">
          <span
            class="flex size-14 items-center justify-center rounded-full border-2 border-cream pl-0.5"
            aria-hidden="true"
          >
            <Play class="size-5 fill-current" aria-hidden="true" />
          </span>
          <span class={cardCaption}>
            {t.videoCta}
            <ArrowUpRight class="size-3.5" aria-hidden="true" />
          </span>
        </div>
      </article>
    </div>
  </div>
</section>
