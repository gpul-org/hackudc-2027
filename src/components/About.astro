---
import ArrowDownRight from "@lucide/astro/icons/arrow-down-right";
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import { copy, type Locale } from "@/i18n/copy";

interface Props {
  locale: Locale;
}

const t = copy[Astro.props.locale];
const [bodyStart, bodyEnd] = t.aboutBody;
const aboutLink =
  "inline-flex items-center gap-2 border-b border-current pb-1.5 text-xs font-black tracking-widest uppercase transition-colors hover:text-red";
---

<!-- Standard section rhythm, except on desktop the lamp sets the bottom edge
     instead of padding: its mast runs off the section, clipped by overflow-hidden. -->
<section
  class="relative overflow-hidden py-16 lg:pt-24 lg:pb-0"
  id="about"
  aria-labelledby="about-title"
>
  <div class="page-wrap">
    <p class="eyebrow text-red reveal" data-reveal>
      {t.aboutLabel}
    </p>
    <h2
      class="mt-4 display-heading reveal"
      data-reveal
      data-leading-punctuation={
        t.aboutTitle.startsWith("¿") ? "true" : undefined
      }
      id="about-title"
    >
      {t.aboutTitle}
    </h2>

    <div class="mt-10 lg:mt-6 lg:flex lg:items-start lg:gap-12 xl:gap-16">
      <!-- Anchored to the bottom so the mast always runs off the edge, even when
           the copy wraps taller than the lamp; the copy keeps its own bottom space. -->
      <img
        class="pointer-events-none hidden max-w-none shrink-0 lg:-mb-12 lg:block lg:self-end lg:w-[clamp(25rem,30vw,28rem)]"
        src="/assets/scene/farola.svg"
        alt=""
        width="706"
        height="742"
        aria-hidden="true"
        loading="lazy"
        decoding="async"
        data-scroll-drift
      />
      <div class="min-w-0 flex-1 text-lg leading-normal lg:pt-6 lg:pb-16 lg:text-xl">
        <p class="reveal" data-reveal>
          {bodyStart}
          <a
            class="whitespace-nowrap underline decoration-1 underline-offset-4 transition-colors hover:text-red"
            href="https://gpul.org"
            target="_blank"
            rel="noopener noreferrer"
          >
            GPUL
            <ArrowUpRight
              class="ml-0.5 inline size-[0.8em] align-baseline"
              aria-hidden="true"
            />
          </a>
          {bodyEnd}
        </p>
        <p class="mt-5 text-base text-ink/70 reveal lg:text-lg" data-reveal>
          {t.aboutDetail}
        </p>
        <div class="mt-8 flex flex-col items-start gap-4 reveal" data-reveal>
          <a class={aboutLink} href="#experience">
            {t.nav[1]}
            <ArrowDownRight class="size-3.5" aria-hidden="true" />
          </a>
          <a
            class={aboutLink}
            href="/assets/manifesto.pdf"
            download="hackudc-manifesto.pdf"
          >
            {t.manifestoCta}
            <ArrowUpRight class="size-3.5" aria-hidden="true" />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
