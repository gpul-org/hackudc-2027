---
import socialImageEs from "@/assets/brand/og-es.jpg";
import socialImageEn from "@/assets/brand/og-en.jpg";
import socialImageGl from "@/assets/brand/og-gl.jpg";
import { copy } from "@/i18n/copy";
import { getAbsoluteLocaleUrl } from "astro:i18n";
import { Font } from "astro:assets";
import { ClientRouter, fade } from "astro:transitions";
import "@/styles/global.css";

interface Props {
  title?: string;
  description: string;
  lang?: string;
}

const { title = "HackUDC 2027", description, lang = "es" } = Astro.props;

const ogLocales = { es: "es_ES", en: "en_US", gl: "gl_ES" } as const;
type Locale = keyof typeof ogLocales;
const locales = Object.keys(ogLocales) as Locale[];
const defaultLocale: Locale = "es";

// Path without the locale prefix, so it can be rebuilt for every locale.
const localePrefix = new RegExp(`^/(${locales.join("|")})(?=/|$)`);
const path = Astro.url.pathname.replace(localePrefix, "").replace(/^\//, "");

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const locale = lang in ogLocales ? (lang as Locale) : defaultLocale;
const socialImages = {
  es: socialImageEs,
  en: socialImageEn,
  gl: socialImageGl,
};
const socialImage = socialImages[locale];
const ogImage = new URL(socialImage.src, Astro.site);
const ogImageAlt = copy[locale].ogImageAlt;
const ogLocale = ogLocales[locale];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <link
      rel="icon"
      type="image/png"
      href="/favicon-96x96.png?v=20261001"
      sizes="96x96"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20261001" />
    <link rel="shortcut icon" href="/favicon.ico?v=20261001" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/apple-touch-icon.png?v=20261001"
    />
    <meta name="apple-mobile-web-app-title" content="HackUDC" />
    <link rel="manifest" href="/site.webmanifest?v=20261001" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <Font cssVariable="--font-inter" />
    <Font cssVariable="--font-rockwell" />

    <link rel="canonical" href={canonicalUrl} />
    {locales.map((locale) => (
      <link
        rel="alternate"
        hreflang={locale}
        href={getAbsoluteLocaleUrl(locale, path)}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={getAbsoluteLocaleUrl(defaultLocale, path)}
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="HackUDC" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={socialImage.width} />
    <meta property="og:image:height" content={socialImage.height} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={ogLocale} />
    {Object.values(ogLocales)
      .filter((alternate) => alternate !== ogLocale)
      .map((alternate) => (
        <meta property="og:locale:alternate" content={alternate} />
      ))}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <ClientRouter />
  </head>
  <body>
    <div transition:animate={fade({ duration: "0.35s" })}>
      <slot />
    </div>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }

  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: 350ms;
  }
</style>
