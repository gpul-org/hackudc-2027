---
import eventPhoto from "@/assets/gallery/group-photo.webp";
import socialImageEs from "@/assets/brand/og-es.jpg";
import socialImageEn from "@/assets/brand/og-en.jpg";
import socialImageGl from "@/assets/brand/og-gl.jpg";
import { copy } from "@/i18n/copy";
import { getAbsoluteLocaleUrl } from "astro:i18n";
import { Font } from "astro:assets";
import { ClientRouter, fade } from "astro:transitions";
import "@/styles/global.css";

interface Props {
  title?: string;
  description: string;
  lang?: string;
}

const { title = "HackUDC 2027", description, lang = "es" } = Astro.props;

const ogLocales = { es: "es_ES", en: "en_US", gl: "gl_ES" } as const;
type Locale = keyof typeof ogLocales;
const locales = Object.keys(ogLocales) as Locale[];
const defaultLocale: Locale = "es";

// Path without the locale prefix, so it can be rebuilt for every locale.
const localePrefix = new RegExp(`^/(${locales.join("|")})(?=/|$)`);
const path = Astro.url.pathname.replace(localePrefix, "").replace(/^\//, "");

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const locale = lang in ogLocales ? (lang as Locale) : defaultLocale;
const socialImages = {
  es: socialImageEs,
  en: socialImageEn,
  gl: socialImageGl,
};
const socialImage = socialImages[locale];
const isHomePage = path === "";
const previewImage = isHomePage ? eventPhoto : socialImage;
const ogImage = new URL(previewImage.src, Astro.site);
const ogImageAlt = isHomePage
  ? copy[locale].primaryPhotoAlt
  : copy[locale].ogImageAlt;
const ogLocale = ogLocales[locale];
const siteUrl = new URL("/", Astro.site);
const websiteId = new URL("#website", siteUrl).href;
const organizerId = "https://gpul.org/#organization";
const primaryImageId = new URL("#primaryimage", canonicalUrl).href;
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": organizerId,
      name: "GPUL",
      alternateName: "Grupo de Programadores e Usuarios de Linux",
      url: "https://gpul.org/",
      email: "hackudc@gpul.org",
      sameAs: [
        "https://www.linkedin.com/company/gpul/",
        "https://github.com/gpul-org",
        "https://www.instagram.com/gpul_",
      ],
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      name: "HackUDC",
      url: siteUrl.href,
      publisher: { "@id": organizerId },
      inLanguage: locales,
    },
    {
      "@type": "ImageObject",
      "@id": primaryImageId,
      contentUrl: ogImage.href,
      width: previewImage.width,
      height: previewImage.height,
      caption: ogImageAlt,
    },
    {
      "@type": "WebPage",
      "@id": new URL("#webpage", canonicalUrl).href,
      url: canonicalUrl.href,
      name: title,
      description,
      inLanguage: locale,
      isPartOf: { "@id": websiteId },
      publisher: { "@id": organizerId },
      primaryImageOfPage: { "@id": primaryImageId },
      ...(isHomePage
        ? { mainEntity: { "@id": new URL("#hackudc", siteUrl).href } }
        : {}),
    },
    ...(isHomePage
      ? [
          {
            "@type": "EventSeries",
            "@id": new URL("#hackudc", siteUrl).href,
            name: "HackUDC",
            url: siteUrl.href,
            description: copy[locale].homeDescription,
            organizer: { "@id": organizerId },
            isAccessibleForFree: true,
            image: { "@id": primaryImageId },
            location: {
              "@type": "Place",
              name: "Facultade de Informática da Universidade da Coruña",
              address: {
                "@type": "PostalAddress",
                streetAddress: "Campus de Elviña",
                addressLocality: "A Coruña",
                addressCountry: "ES",
              },
            },
          },
        ]
      : []),
  ],
};
---

<!doctype html>
<html lang={lang} transition:animate={fade({ duration: "0.35s" })}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <link
      rel="icon"
      type="image/png"
      href="/favicon-96x96.png?v=20261001"
      sizes="96x96"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20261001" />
    <link rel="shortcut icon" href="/favicon.ico?v=20261001" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/apple-touch-icon.png?v=20261001"
    />
    <meta name="apple-mobile-web-app-title" content="HackUDC" />
    <link rel="manifest" href="/site.webmanifest?v=20261001" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <meta name="robots" content="max-image-preview:large" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
    ></script>
    <Font cssVariable="--font-inter" />
    <Font cssVariable="--font-rockwell" />

    <link rel="canonical" href={canonicalUrl} />
    {locales.map((locale) => (
      <link
        rel="alternate"
        hreflang={locale}
        href={getAbsoluteLocaleUrl(locale, path)}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={getAbsoluteLocaleUrl(defaultLocale, path)}
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="HackUDC" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta
      property="og:image:type"
      content={isHomePage ? "image/webp" : "image/jpeg"}
    />
    <meta property="og:image:width" content={previewImage.width} />
    <meta property="og:image:height" content={previewImage.height} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={ogLocale} />
    {Object.values(ogLocales)
      .filter((alternate) => alternate !== ogLocale)
      .map((alternate) => (
        <meta property="og:locale:alternate" content={alternate} />
      ))}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <ClientRouter />
  </head>
  <body>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }

  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: 350ms;
  }
</style>
