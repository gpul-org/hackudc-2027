---
import { getRelativeLocaleUrl } from "astro:i18n";
import LegalContents from "@/components/LegalContents.astro";
import PageHeader from "@/components/PageHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { copy, type Locale } from "@/i18n/copy";
import Layout from "@/layouts/Layout.astro";

type Policy = "terms" | "privacy" | "conduct" | "manifesto";

const { frontmatter } = Astro.props;
const locale = frontmatter.locale as Locale;
const policy = frontmatter.policy as Policy;
const t = copy[locale];
const homeUrl = getRelativeLocaleUrl(locale, "");
// Markdown encodes braces in link destinations before the layout receives HTML.
const legalContent = (await Astro.slots.render("default")).replace(
  /(?:\{|%7B)(privacy|terms|conduct)Url(?:\}|%7D)/gi,
  (_, policyPath: string) => getRelativeLocaleUrl(locale, policyPath),
);
const localeUrls: Record<Locale, string> = {
  es: getRelativeLocaleUrl("es", policy),
  en: getRelativeLocaleUrl("en", policy),
  gl: getRelativeLocaleUrl("gl", policy),
};
---

<Layout
  lang={locale}
  title={frontmatter.title}
  description={frontmatter.description}
>
  <div class="min-h-dvh bg-cream text-ink">
    <PageHeader
      locale={locale}
      localeUrls={localeUrls}
      homeUrl={homeUrl}
      backLabel={t.backHome}
      backShortLabel={t.backHomeShort}
    />

    <main class="page-wrap pb-16 sm:pb-24 lg:grid lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-10 xl:grid-cols-[16rem_minmax(0,1fr)]">
      <LegalContents locale={locale} headings={Astro.props.headings} />
      <article class="legal-copy min-w-0 max-w-3xl" data-legal-content>
        <p class="eyebrow text-red">HackUDC 2027</p>
        <Fragment set:html={legalContent} />
      </article>
    </main>

    <SiteFooter locale={locale} />
  </div>
</Layout>

<style>
  .legal-copy :global(h2),
  .legal-copy :global(h3) {
    scroll-margin-top: 2rem;
  }

  .legal-copy :global(h1) {
    margin-top: 1rem;
    font-family: var(--font-serif);
    font-size: clamp(2.25rem, 6vw, 3.75rem);
    line-height: 1;
    text-wrap: balance;
  }
  .legal-copy :global(h2) {
    margin-top: 2.75rem;
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: 1.05;
    text-wrap: balance;
  }
  .legal-copy :global(h3) {
    margin-top: 1.75rem;
    font-size: 1.05rem;
    font-weight: 800;
    line-height: 1.3;
  }
  .legal-copy :global(p),
  .legal-copy :global(li) {
    margin-top: 1rem;
    font-size: 1rem;
    line-height: 1.65;
    text-wrap: pretty;
  }
  .legal-copy :global(ul),
  .legal-copy :global(ol) {
    margin-top: 1rem;
    padding-inline-start: 1.5rem;
  }
  .legal-copy :global(ul) {
    list-style: disc;
  }
  .legal-copy :global(ol) {
    list-style: decimal;
  }
  .legal-copy :global(li + li),
  .legal-copy :global(li > ul) {
    margin-top: 0.4rem;
  }
  .legal-copy :global(a) {
    color: var(--color-red);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  .legal-copy :global(blockquote) {
    margin-top: 2rem;
    border-inline-start: 4px solid var(--color-red);
    padding-inline-start: 1.25rem;
    font-family: var(--font-serif);
    font-size: 1.35rem;
    line-height: 1.2;
  }
</style>
